# Mutable allowlist for the identity-sms registration-only API. PM2 pins APP_ENV=test,
# AUTH_MODE=membership, IDENTITY_REGISTRATION_API_PROFILE, bind host and port.
SERVICE_VERSION=replace-with-staging-release-commit
API_ALLOWED_ORIGINS=https://accounts.staging.example.invalid,https://console.staging.example.invalid
AUTH_RETURN_TARGETS='{"console":"https://console.staging.example.invalid","console-hbbtzn":"https://console.staging.example.invalid","storefront":"https://disabled.staging.example.invalid","storefront-hbbtzn":"https://disabled.staging.example.invalid","store":"https://console.staging.example.invalid/entrances/store","supplier":"https://console.staging.example.invalid/entrances/supplier"}'
DATABASE_API_CONNECTION_REF=zhudatuan-staging/registration/database/api
SESSION_KEY_REF=zhudatuan-staging/registration/identity/session
IDENTITY_KEY_REF=zhudatuan-staging/registration/identity/index
SECRET_STORE_ENDPOINT=https://secrets.staging.example.invalid
SECRET_STORE_BEARER_TOKEN=REPLACE_STAGING_API_SECRET_STORE_TOKEN_000000000
KMS_ENDPOINT=https://kms.staging.example.invalid
KMS_BEARER_TOKEN=REPLACE_STAGING_API_KMS_BEARER_TOKEN_00000000000
NODE_EXTRA_CA_CERTS=/opt/zhudatuan-staging/shared/tls/internal-ca.crt
