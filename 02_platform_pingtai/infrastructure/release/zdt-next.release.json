  "rules": [
    {
      "id": "validation-only",
      "validationOnly": true,
      "targets": [],
      "include": ["05_docs_ziliao/**","**/*.md","**/tests/**","**/test/**","**/fixtures/**","**/*fixture*","**/*.test.*","**/*.spec.*"],
      "validations": [],
      "reason": "changed files require validation but are not production artifacts"
    },
    {
      "id": "database-validation",
      "validationOnly": true,
      "targets": [],
      "include": ["02_platform_pingtai/database/**/tests/**","02_platform_pingtai/database/**/*fixture*","03_quality_ceshi/**"],
      "validations": [
        {"name":"database-migration-ledger","argv":["npm","run","check:migrations"],"timeoutMs":600000}
      ],
      "reason": "database tests and fixtures validate without producing a production migration"
    },
    {
      "id": "workspace-dependencies",
      "targets": [],
      "include": ["package.json","package-lock.json","01_core_hexin/**/package.json","04_tools/tools/*/package.json"],
      "dynamicImpact": "workspace-graph",
      "touches": ["workspace-dependencies"],
      "reason": "workspace dependency graph"
    },
    {
      "id": "database",
      "targets": ["database-migration"],
      "include": ["02_platform_pingtai/database/**/migrations/*.sql"],
      "touches": ["database"],
      "reason": "production database migration",
      "validations": [
        {"name":"database-migration-ledger","argv":["npm","run","check:migrations"],"timeoutMs":600000}
      ]
    },
    {
      "id": "caddy",
      "targets": ["catalog-media","storefront","auth-web","console","identity-api","identity-notification-jobs","mall-provisioning-api","support-api","purchase-api","web-api","catalog-api","catalog-jobs","payment-webhook-api","payment-jobs"],
      "include": ["**/Caddyfile","**/Caddyfile.*"],
      "touches": ["caddy"],
      "reason": "reverse proxy configuration"
    },
    {
      "id": "tunnel",
      "targets": ["catalog-media","storefront","auth-web","console","identity-api","identity-notification-jobs","mall-provisioning-api","support-api","purchase-api","web-api","catalog-api","catalog-jobs","payment-webhook-api","payment-jobs"],
      "include": ["**/*cloudflared*","**/wrangler.json","**/wrangler.jsonc","02_platform_pingtai/infrastructure/**/cloudflare/**"],
      "touches": ["tunnel"],
      "reason": "edge or tunnel configuration"
    },
    {
      "id": "catalog-jobs-environment",
      "targets": ["catalog-jobs"],
      "include": ["02_platform_pingtai/config/node-runtime/**/catalog-jobs.env","02_platform_pingtai/config/node-runtime/**/catalog-jobs.env.*"],
      "touches": ["environment"],
      "reason": "catalog jobs runtime environment contract"
    },
    {
      "id": "environment",
      "targets": ["catalog-media","storefront","auth-web","console","identity-api","identity-notification-jobs","mall-provisioning-api","support-api","purchase-api","web-api","catalog-api","catalog-jobs","payment-webhook-api","payment-jobs"],
      "include": ["**/*.env","**/*.env.*","**/*.env.example"],
      "exclude": ["02_platform_pingtai/config/node-runtime/**/catalog-jobs.env","02_platform_pingtai/config/node-runtime/**/catalog-jobs.env.*"],
      "touches": ["environment"],
      "reason": "runtime environment contract"
    },
    {
      "id": "sfl-node-kernel",
      "targets": ["console","identity-api","identity-notification-jobs","mall-provisioning-api","support-api","purchase-api","web-api","catalog-api","catalog-jobs","payment-webhook-api","payment-jobs"],
      "include": ["02_platform_pingtai/config/node-manifests/**","02_platform_pingtai/config/sfl-*/**","01_core_hexin/packages/config/src/SflNode*"],
      "touches": ["sfl-node-kernel"],
      "reason": "SFL node kernel or manifest affects console and commerce runtimes"
    },
    {"id":"catalog-media","targets":["catalog-media"],"include":["01_core_hexin/apps/storefront-web/public/catalog-media/**"],"reason":"content-addressed catalog media"},
    {
      "id": "storefront",
      "targets": ["storefront"],
      "include": ["01_core_hexin/apps/storefront-web/**"],
      "exclude": ["01_core_hexin/apps/storefront-web/public/catalog-media/**"],
      "reason": "storefront-only change"
    },
    {"id":"auth-web","targets":["auth-web"],"include":["01_core_hexin/apps/auth-web/**"],"reason":"auth static client change"},
    {"id":"console","targets":["console"],"include":["01_core_hexin/apps/console/**"],"reason":"console static client change"},
    {
      "id": "session-resolver-compat",
      "targets": ["identity-api","web-api"],
      "include": ["01_core_hexin/services/commerce/src/foundation/security/PgAccessResolvers*.ts"],
      "reason": "identity and web session database compatibility"
    },
    {
      "id": "mall-provisioning-isolation",
      "targets": [],
      "include": ["01_core_hexin/services/commerce/src/modules/provisioning/03_application_yingyong/CreateMall.ts"],
      "reason": "mall provisioning dependency isolation is not hosted by a fast production target"
    },
    {
      "id": "identity-api-entry",
      "targets": ["identity-api"],
      "include": ["01_core_hexin/services/commerce/src/entry/IdentityRegistrationApi*","01_core_hexin/services/commerce/src/bootstrap/IdentityRegistrationApiRuntime*"],
      "reason": "single identity runtime"
    },
    {
      "id": "identity-notification-jobs-entry",
      "targets": ["identity-notification-jobs"],
      "include": ["01_core_hexin/services/commerce/src/entry/IdentityNotificationJobs*","01_core_hexin/services/commerce/src/bootstrap/IdentityNotificationJobsRuntime*"],
