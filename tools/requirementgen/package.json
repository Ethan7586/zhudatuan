{
  "name": "@shop/requirementgen",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "npm run typecheck",
    "generate": "npm run generate:source && npm run generate:trace && npm run generate:release",
    "generate:source": "node --import tsx src/RequirementSourceGenerator.ts",
    "generate:trace": "node --import tsx src/RequirementGenerator.ts",
    "generate:release": "node --import tsx src/ReleaseIndex.ts",
    "check": "npm run check:source && npm run check:trace && npm run check:release",
    "check:source": "node --import tsx src/RequirementSourceGenerator.ts --check",
    "check:trace": "node --import tsx src/RequirementGenerator.ts --check",
    "check:release": "node --import tsx src/ReleaseIndex.ts --check",
    "lint": "npm run typecheck",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fflate": "0.7.5",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
