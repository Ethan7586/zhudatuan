# Dedicated full-staging RDS private endpoint. Never use the formal-production
# endpoint. The proxy uses this hostname for both SNI and certificate validation.
ZHUDATUAN_POSTGRES_PROXY_UPSTREAM_HOST=replace-with-staging-rds-private-endpoint.pg.rds.aliyuncs.com
ZHUDATUAN_POSTGRES_PROXY_UPSTREAM_PORT=5432
ZHUDATUAN_POSTGRES_PROXY_CA_FILE=/opt/zhudatuan-staging-full/shared/tls/aliyun-rds-ca.pem
