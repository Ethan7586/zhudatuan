# One-shot BootstrapStagingOwner environment. The database loopback proxy and the
# dedicated staging Secret Store are hard deployment boundaries; provision them first.
APP_ENV=staging
ZHUDATUAN_OWNER_BOOTSTRAP_CONFIRM=CREATE_ONE_ZHUDATUAN_STAGING_CONSOLE_OWNER_ETHAN
ZHUDATUAN_OWNER_BOOTSTRAP_DATABASE_URL=postgresql://zhudatuanbootstrap:replace-with-dedicated-staging-password@127.0.0.1:55442/zhudatuan_registration
ZHUDATUAN_OWNER_BOOTSTRAP_DATABASE_NAME=zhudatuan_registration
ZHUDATUAN_OWNER_BOOTSTRAP_SENTINEL=staging_REPLACE_FULL_OWNER_SENTINEL_000000000000000000
ZHUDATUAN_OWNER_BOOTSTRAP_ACTOR=owner:staging:Ethan
ZHUDATUAN_OWNER_PASSWORD_REF=zhudatuan/staging/full/registration/owner/password
ZHUDATUAN_OWNER_BOOTSTRAP_RECEIPT_REF=zhudatuan/staging/full/registration/owner/bootstrap-receipt
IDENTITY_KEY_REF=zhudatuan/staging/full/identity/index
SECRET_STORE_ENDPOINT=https://127.0.0.1:8643
SECRET_STORE_BEARER_TOKEN=REPLACE_FULL_SHARED_SECRET_STORE_TOKEN_000000000000
NODE_EXTRA_CA_CERTS=/opt/zhudatuan-staging-full/shared/tls/internal-ca.crt
