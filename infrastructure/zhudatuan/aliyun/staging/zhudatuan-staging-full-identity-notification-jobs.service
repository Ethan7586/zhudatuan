[Unit]
Description=Zhudatuan full staging identity OTP notification worker
Wants=network-online.target
Requires=zhudatuan-staging-full-postgres-proxy.service zhudatuan-staging-full-internal-runtime.service
After=network-online.target zhudatuan-staging-full-postgres-proxy.service zhudatuan-staging-full-internal-runtime.service zhudatuan-staging-full-migration.service zhudatuan-staging-full-owner-bootstrap.service zhudatuan-staging-full-database-retire.service
ConditionPathExists=/opt/zhudatuan-staging-full/current/services/commerce/dist/IdentityNotificationJobsOnlyMain.js
ConditionPathExists=/opt/zhudatuan-staging-full/current/services/commerce/dist/IdentityNotificationJobsReadyMain.js
ConditionPathExists=/opt/zhudatuan-staging-full/shared/full-identity-notification-jobs.env
ConditionPathExists=/opt/zhudatuan-staging-full/shared/tls/internal-ca.crt
ConditionPathExists=!/opt/zhudatuan-staging-full/shared/full-migration.env
ConditionPathExists=!/opt/zhudatuan-staging-full/shared/full-owner-bootstrap.env
ConditionPathExists=!/run/zhudatuan-staging-full/rds-init.env
ConditionPathExists=!/run/zhudatuan-staging-full/database-retire.env
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
DynamicUser=yes
User=zdt-stg-full-idjobs
WorkingDirectory=/opt/zhudatuan-staging-full/current
EnvironmentFile=/opt/zhudatuan-staging-full/shared/full-identity-notification-jobs.env
LoadCredential=internal-ca.crt:/opt/zhudatuan-staging-full/shared/tls/internal-ca.crt
ExecStartPre=/usr/bin/env NODE_ENV=production APP_ENV=production JOB_RUNTIME_PROFILE=identity-notification-only \
  DATABASE_JOB_CONNECTION_REF=zhudatuan/staging/full/database/identity-notification-jobs \
  IDENTITY_NOTIFICATION_CONFIG_REF=zhudatuan/staging/full/notification/identity-sms \
  SECRET_STORE_ENDPOINT=https://127.0.0.1:8643 KMS_ENDPOINT=https://127.0.0.1:8644 \
  NODE_EXTRA_CA_CERTS=%d/internal-ca.crt \
  /usr/bin/node services/commerce/dist/IdentityNotificationJobsReadyMain.js
ExecStart=/usr/bin/env NODE_ENV=production APP_ENV=production JOB_RUNTIME_PROFILE=identity-notification-only \
  DATABASE_JOB_CONNECTION_REF=zhudatuan/staging/full/database/identity-notification-jobs \
  IDENTITY_NOTIFICATION_CONFIG_REF=zhudatuan/staging/full/notification/identity-sms \
  SECRET_STORE_ENDPOINT=https://127.0.0.1:8643 KMS_ENDPOINT=https://127.0.0.1:8644 \
  NODE_EXTRA_CA_CERTS=%d/internal-ca.crt \
  /usr/bin/node services/commerce/dist/IdentityNotificationJobsOnlyMain.js
Restart=on-failure
RestartSec=3
TimeoutStartSec=45
TimeoutStopSec=45
RuntimeDirectory=zdt-stg-full-idjobs
RuntimeDirectoryMode=0700
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zhudatuan-staging-full-identity-notification-jobs
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
KeyringMode=private
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SocketBindDeny=any
ReadOnlyPaths=/opt/zhudatuan-staging-full/current /opt/zhudatuan-staging-full/shared
InaccessiblePaths=-/opt/zhudatuan -/opt/smart-wing -/opt/smart-wiston -/opt/shop-test

# Do not add PrivateNetwork= or IPAddressDeny=any: this worker needs ECS IMDSv2
# at 100.100.100.200 and outbound TLS to the Alibaba Cloud SMS endpoint.
# Deliberately no [Install]: P10 starts this unit explicitly after evidence verification.
