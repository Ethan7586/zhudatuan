# Ephemeral root-only input for the post-bootstrap retirement one-shot.
# Install at /run/zhudatuan-staging-full/database-retire.env as root:root 0600;
# delete it together with rds-init.env before any public runtime starts.
PGUSER=replace-with-isolated-staging-rds-admin-user
PGPASSWORD=replace-with-isolated-staging-rds-admin-password
