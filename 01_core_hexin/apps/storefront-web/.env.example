# Client-visible account-center origin. The resolver accepts only the canonical
# production origin or the approved local :3002 development origin.
NEXT_PUBLIC_AUTH_ORIGIN="http://127.0.0.1:3002"
# Development-only node registry override. Production builds use the canonical manifest.
NEXT_PUBLIC_IDENTITY_NODE_REGISTRY='{"version":2,"nodes":[{"nodeId":"local","nodeProfile":"operating_mall","mallId":"mall-local","displayName":"本地身份节点","accountsOrigin":"http://127.0.0.1:3002","apiOrigin":"http://127.0.0.1:3001","consumerApiOrigin":"http://127.0.0.1:3001","adminOrigin":"http://127.0.0.1:4173","storefrontOrigin":"http://127.0.0.1:3000","storefrontHosts":["localhost"],"adminTarget":"console","consumerTarget":"storefront","consumerApplication":"local-storefront"}]}'
NEXT_PUBLIC_STOREFRONT_HOSTNAME="127.0.0.1"

# Runtime-only boundary. Production must set APP_ENV=production so preview
# routes stay disabled on public storefront domains.
APP_ENV="development"
