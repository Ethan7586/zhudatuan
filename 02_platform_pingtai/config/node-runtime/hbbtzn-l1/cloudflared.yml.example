tunnel: REPLACE_WITH_HBBTZN_L1_TUNNEL_UUID
credentials-file: /opt/sfl/nodes/hbbtzn-l1/tunnel/credentials.json
metrics: 127.0.0.1:49301
no-autoupdate: true

originRequest:
  matchSNItoHost: true
  caPool: /opt/sfl/nodes/hbbtzn-l1/runtime/tls/origin-ca.crt
  connectTimeout: 5s

ingress:
  - hostname: api.fufuwang.com.cn
    service: https://127.0.0.1:4430
  - hostname: accounts.fufuwang.com.cn
    service: https://127.0.0.1:4430
  - hostname: console.fufuwang.com.cn
    service: https://127.0.0.1:4430
  - hostname: fufuwang.com.cn
    service: https://127.0.0.1:4430
  - hostname: www.fufuwang.com.cn
    service: https://127.0.0.1:4430
  - hostname: h5.fufuwang.com.cn
    service: https://127.0.0.1:4430
  - hostname: h6.fufuwang.com.cn
    service: https://127.0.0.1:4430
  - hostname: mall.fufuwang.com.cn
    service: https://127.0.0.1:4430
  - service: http_status:404
