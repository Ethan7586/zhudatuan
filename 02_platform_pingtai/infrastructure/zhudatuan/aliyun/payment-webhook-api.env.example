# Exact mutable allowlist for zhudatuan-payment-webhook-api.service. Profile, host and port are pinned by systemd.
APP_ENV=production
SERVICE_VERSION=replace-with-release-commit
DATABASE_API_CONNECTION_REF=zhudatuan/payment-webhook/database/api
SECRET_STORE_ENDPOINT=https://127.0.0.1:8543
SECRET_STORE_BEARER_TOKEN=REPLACE_WITH_THE_PAYMENT_WEBHOOK_SECRET_STORE_BEARER_TOKEN!
WECHAT_APPLICATION_CONFIG_REF=zhudatuan/purchase/wechat/applications
WECHAT_PAYMENT_CONFIG_REF=zhudatuan/purchase/payment/wechat
NODE_EXTRA_CA_CERTS=/opt/zhudatuan/shared/tls/internal-ca.crt
