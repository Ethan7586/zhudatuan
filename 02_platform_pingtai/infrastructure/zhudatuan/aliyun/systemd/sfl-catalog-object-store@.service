[Unit]
Description=SFL node-bound catalog object store (%i)
After=network-online.target
ConditionPathExists=/opt/sfl/nodes/%i/current/01_core_hexin/services/commerce/dist/LocalObjectsMain.js
ConditionPathExists=/opt/sfl/nodes/%i/current/01_core_hexin/services/commerce/dist/CatalogObjectStoreReadyMain.js
ConditionPathExists=/opt/sfl/nodes/%i/runtime/object-store.env

[Service]
Type=simple
User=zhudatuan
Group=zhudatuan
WorkingDirectory=/opt/sfl/nodes/%i/current
Environment=NODE_ENV=production
Environment=APP_ENV=production
EnvironmentFile=/opt/sfl/nodes/%i/runtime/object-store.env
ExecStart=/usr/bin/node 01_core_hexin/services/commerce/dist/LocalObjectsMain.js
ExecStartPost=/usr/bin/node 01_core_hexin/services/commerce/dist/CatalogObjectStoreReadyMain.js
Restart=on-failure
RestartSec=3
TimeoutStartSec=30
TimeoutStopSec=30
StateDirectory=sfl-%i-objects
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
PrivateDevices=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/opt/sfl/nodes/%i /opt/zhudatuan/shared

[Install]
WantedBy=multi-user.target
