VITE_IDENTITY_NODE_REGISTRY='{"version":2,"defaultNodeId":"local","nodes":[{"nodeId":"local","nodeProfile":"operating_mall","mallId":"mall-local","displayName":"本地身份节点","accountsOrigin":"http://localhost:3002","apiOrigin":"http://127.0.0.1:3001","consumerApiOrigin":"http://127.0.0.1:3001","adminOrigin":"http://127.0.0.1:4173","storefrontOrigin":"http://127.0.0.1:3000","storefrontHosts":["localhost"],"adminTarget":"console","consumerTarget":"storefront","consumerApplication":"zhudatuan-storefront"}]}'
VITE_CLIENT_VERSION="0.0.0"
