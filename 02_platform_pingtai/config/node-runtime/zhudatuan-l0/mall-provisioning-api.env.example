APP_ENV=production
AUTH_MODE=membership
SERVICE_VERSION=replace-with-release-source-sha
MALL_PROVISIONING_API_PROFILE=mall-provisioning-only
API_PORT=4325
API_BIND_HOST=127.0.0.1
API_ALLOWED_ORIGINS=https://console.fufu.wang
DATABASE_API_CONNECTION_REF=zhudatuan/nodes/l0/database/mall-provisioning-api
SECRET_STORE_ENDPOINT=https://127.0.0.1:8553
SECRET_STORE_BEARER_TOKEN=REPLACE_WITH_L0_MALL_PROVISIONING_SECRET_STORE_TOKEN
NODE_MANIFEST_PATH=/opt/sfl/nodes/zhudatuan-l0/manifest.json
NODE_MANIFEST_ID=manifest:zhudatuan:l0:v1
NODE_MANIFEST_DIGEST=sha256:REPLACE_WITH_GENERATED_DIGEST
NODE_RUNTIME_INSTANCE_ID=runtime:zhudatuan:l0:commerce
NODE_RUNTIME_CONFIG_REF=sfl/nodes/zhudatuan-l0/runtime/v1
NODE_RESOURCE_BINDING_VERSION=1
NODE_RELEASE_POINTER_REF=/opt/sfl/nodes/zhudatuan-l0/current
NODE_EXTRA_CA_CERTS=/opt/zhudatuan/shared/tls/internal-ca.crt
