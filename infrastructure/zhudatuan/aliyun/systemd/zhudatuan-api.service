[Unit]
Description=Zhudatuan Canonical API
Requires=zhudatuan-migration.service zhudatuan-internal-runtime.service docker.service
After=network-online.target zhudatuan-migration.service zhudatuan-internal-runtime.service docker.service
ConditionPathExists=/opt/zhudatuan/current/services/commerce/dist/IdentityRegistrationApiMain.js
ConditionPathExists=/opt/zhudatuan/current/services/commerce/dist/IdentityRegistrationApiReadyMain.js
ConditionPathExists=/opt/zhudatuan/shared/api.env

[Service]
Type=simple
User=zhudatuan
Group=zhudatuan
WorkingDirectory=/opt/zhudatuan/current
Environment=NODE_ENV=production
Environment=IDENTITY_REGISTRATION_API_PROFILE=registration-only
Environment=API_PORT=4321
Environment=API_BIND_HOST=127.0.0.1
EnvironmentFile=/opt/zhudatuan/shared/api.env
ExecStart=/usr/bin/node services/commerce/dist/IdentityRegistrationApiMain.js
ExecStartPost=/usr/bin/node services/commerce/dist/IdentityRegistrationApiReadyMain.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
PrivateDevices=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/opt/zhudatuan/current /opt/zhudatuan/shared
InaccessiblePaths=-/opt/smart-wing -/opt/smart-wiston -/opt/shop-test

[Install]
WantedBy=multi-user.target
