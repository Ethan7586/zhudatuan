# Owner-approved production origins and return targets are code-pinned; this file must match them exactly.
# Profile, host and port are pinned by systemd Environment.
APP_ENV=production
AUTH_MODE=membership
SERVICE_VERSION=replace-with-release-commit
API_ALLOWED_ORIGINS=https://accounts.hbbtzn.com,https://accounts.zhudatuan.com,https://console.zhudatuan.com,https://hbbtzn.com,https://mall.hbbtzn.com,https://www.hbbtzn.com,https://zhudatuan.com
AUTH_RETURN_TARGETS='{"console":"https://console.zhudatuan.com","storefront":"https://mall.hbbtzn.com","store":"https://console.zhudatuan.com/entrances/store","supplier":"https://console.zhudatuan.com/entrances/supplier"}'
DATABASE_API_CONNECTION_REF=zhudatuan/registration/database/api
SESSION_KEY_REF=zhudatuan/registration/identity/session
IDENTITY_KEY_REF=zhudatuan/registration/identity/index
KMS_ENDPOINT=https://127.0.0.1:8544
KMS_BEARER_TOKEN=REPLACE_WITH_THE_RUNTIME_KMS_BEARER_TOKEN!
SECRET_STORE_ENDPOINT=https://127.0.0.1:8543
SECRET_STORE_BEARER_TOKEN=REPLACE_WITH_THE_RUNTIME_SECRET_STORE_BEARER_TOKEN!
NODE_EXTRA_CA_CERTS=/opt/zhudatuan/shared/tls/internal-ca.crt
