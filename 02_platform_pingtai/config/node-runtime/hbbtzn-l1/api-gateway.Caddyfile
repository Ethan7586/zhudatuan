# Generated from manifest:hbbtzn:l1:v1 (sha256:b46f95da5f7b4e1085e5189af2d57e10cf432500aa50c390096eda034076c24f). Do not hand edit.
{
	admin off
	auto_https off
}

https://:4430 {
	tls /opt/sfl/nodes/hbbtzn-l1/runtime/tls/origin.crt /opt/sfl/nodes/hbbtzn-l1/runtime/tls/origin.key
	encode gzip

	@purchaseWrite {
		host api.hbbtzn.com
		method POST OPTIONS
		path /api/v1/checkouts/quotes /api/v1/orders /api/v1/payments/intents
	}
	handle @purchaseWrite {
		reverse_proxy 127.0.0.1:4434 {
			header_up Host {http.request.host}
			header_up X-Real-IP {http.request.header.CF-Connecting-IP}
			header_up -X-Sfl-Node-Id
			header_up -X-Sfl-Node-Manifest-Id
			header_up -X-Sfl-Node-Surface
			header_up -X-Zdt-Identity-Entry-Host
		}
	}

	@paymentRead {
		host api.hbbtzn.com
		method GET HEAD OPTIONS
		path /api/v1/payments/intents/*
	}
	handle @paymentRead {
		reverse_proxy 127.0.0.1:4434 {
