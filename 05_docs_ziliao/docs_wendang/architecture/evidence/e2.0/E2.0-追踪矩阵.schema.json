{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhudatuan.local/schemas/e2.0/traceability-matrix.schema.json",
  "title": "E2.0 Traceability Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "non_gating", "retrieved_on", "standards", "claims"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "e2.0-traceability-matrix-v2" },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "classification", "certification_claim", "criteria_lock"],
      "properties": {
        "id": { "const": "E2.0" },
        "name": { "const": "E2.0 国际标准对标验收体系" },
        "version": { "type": "string" },
        "classification": { "const": "standards-aligned-tailored-conformity-profile" },
        "certification_claim": { "const": false },
        "criteria_lock": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "locked_on", "predecessor_commit", "identity", "change_rule"],
          "properties": {
            "status": { "const": "LOCKED" },
            "locked_on": { "type": "string", "format": "date" },
            "predecessor_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            "identity": { "const": "GIT_COMMIT_CONTAINING_PROFILE" },
            "change_rule": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "non_gating": { "const": true },
    "retrieved_on": { "type": "string", "format": "date" },
    "standards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["standard_id", "title", "version", "status", "official_url", "retrieved_on", "access_depth", "profile_usage", "scope_status", "notes"],
        "properties": {
          "standard_id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "minLength": 1 },
          "official_url": { "type": "string", "format": "uri" },
          "retrieved_on": { "type": "string", "format": "date" },
          "access_depth": { "enum": ["OFFICIAL_PUBLIC_METADATA", "OFFICIAL_PUBLIC_FULL_TEXT", "AUTHORIZED_FULL_TEXT"] },
          "profile_usage": { "type": "string", "minLength": 1 },
          "scope_status": { "enum": ["ACTIVE", "REFERENCE_ONLY", "NOT_ACTIVATED", "DEFERRED"] },
          "notes": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "legacy_trace_ids",
          "title",
          "quality_statement",
          "project_custom_assertion",
          "business_risks",
          "standard_mappings",
          "applicability",
          "test_basis_refs",
          "independent_oracle",
          "target_environments",
          "inputs",
          "prelocked_criteria",
          "positive_cases",
          "negative_cases",
          "required_raw_evidence",
          "executor_role",
          "reviewer_role",
          "current_rating"
        ],
        "properties": {
          "claim_id": { "type": "string", "pattern": "^E2-[A-Z]+-[0-9]{3}$" },
          "legacy_trace_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^E[0-9]{2}$" } },
          "title": { "type": "string", "minLength": 1 },
          "quality_statement": { "type": "string", "minLength": 1 },
          "project_custom_assertion": { "type": "boolean" },
          "business_risks": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "standard_mappings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["standard_id", "locator", "mapping_type", "alignment_statement", "exact_clause_conformity_claimed"],
              "properties": {
                "standard_id": { "type": "string", "minLength": 1 },
                "locator": { "type": ["string", "null"] },
                "mapping_type": { "enum": ["QUALITY_MODEL_ALIGNMENT", "PROCESS_ALIGNMENT", "EXACT_OPEN_REQUIREMENT_MAPPING", "PROJECT_CUSTOM"] },
                "alignment_statement": { "type": "string", "minLength": 1 },
                "exact_clause_conformity_claimed": { "type": "boolean" }
              },
              "allOf": [
                {
                  "if": {
                    "type": "object",
                    "properties": { "mapping_type": { "const": "EXACT_OPEN_REQUIREMENT_MAPPING" } },
                    "required": ["mapping_type"]
                  },
                  "then": {
                    "type": "object",
                    "properties": { "locator": { "type": "string", "minLength": 1 } }
                  }
                }
              ]
            }
          },
          "applicability": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "rationale", "tailoring_ref", "review_trigger"],
            "properties": {
              "status": { "enum": ["APPLICABLE", "NOT APPLICABLE", "UNKNOWN"] },
              "rationale": { "type": "string", "minLength": 1 },
              "tailoring_ref": { "type": ["string", "null"] },
              "review_trigger": { "type": "string", "minLength": 1 }
            }
          },
          "test_basis_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "independent_oracle": {
            "type": "object",
            "additionalProperties": false,
            "required": ["oracle_id", "procedure", "does_not_read_test_pass"],
            "properties": {
              "oracle_id": { "type": "string", "minLength": 1 },
              "procedure": { "type": "string", "minLength": 1 },
              "does_not_read_test_pass": { "const": true }
            }
          },
          "target_environments": { "type": "array", "minItems": 1, "items": { "enum": ["DEV", "STAGING", "PRODUCTION"] } },
          "inputs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "prelocked_criteria": {
            "type": "object",
            "additionalProperties": false,
            "required": ["thresholds", "all_required", "unknown_rule"],
            "properties": {
              "thresholds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "all_required": { "const": true },
              "unknown_rule": { "type": "string", "minLength": 1 }
            }
          },
          "positive_cases": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "negative_cases": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "required_raw_evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "executor_role": { "type": "string", "minLength": 1 },
          "reviewer_role": { "type": "string", "minLength": 1 },
          "current_rating": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claim_outcome", "environment_assurance", "review_assurance", "rationale", "evidence_ref", "review_evidence_ref", "gaps"],
            "properties": {
              "claim_outcome": { "enum": ["MET", "NOT MET", "UNKNOWN", "NOT APPLICABLE"] },
              "environment_assurance": { "enum": ["DEV VERIFIED", "STAGING VERIFIED", "PRODUCTION OBSERVED", "NOT ESTABLISHED"] },
              "review_assurance": { "enum": ["NOT REVIEWED", "INTERNAL PEER REVIEWED", "INDEPENDENTLY REVIEWED"] },
              "rationale": { "type": "string", "minLength": 1 },
              "evidence_ref": { "type": ["string", "null"] },
              "review_evidence_ref": { "type": ["string", "null"] },
              "gaps": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "anyOf": [
          {
            "properties": { "project_custom_assertion": { "type": "boolean", "const": true } },
            "required": ["project_custom_assertion"]
          },
          {
            "properties": { "standard_mappings": { "type": "array", "minItems": 1 } },
            "required": ["standard_mappings"]
          }
        ],
        "allOf": [
          {
            "if": {
              "properties": { "applicability": { "type": "object", "properties": { "status": { "const": "APPLICABLE" } }, "required": ["status"] } }
            },
            "then": {
              "properties": { "current_rating": { "type": "object", "properties": { "claim_outcome": { "enum": ["MET", "NOT MET", "UNKNOWN"] } } } }
            }
          },
          {
            "if": {
              "properties": { "applicability": { "type": "object", "properties": { "status": { "const": "NOT APPLICABLE" } }, "required": ["status"] } }
            },
            "then": {
              "properties": {
                "applicability": { "type": "object", "properties": { "tailoring_ref": { "type": "string", "minLength": 1 } } },
                "current_rating": {
                  "type": "object",
                  "properties": {
                    "claim_outcome": { "const": "NOT APPLICABLE" },
                    "environment_assurance": { "const": "NOT ESTABLISHED" },
                    "evidence_ref": { "type": "null" }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": { "applicability": { "type": "object", "properties": { "status": { "const": "UNKNOWN" } }, "required": ["status"] } }
            },
            "then": {
              "properties": {
                "current_rating": {
                  "type": "object",
                  "properties": {
                    "claim_outcome": { "const": "UNKNOWN" },
                    "environment_assurance": { "const": "NOT ESTABLISHED" },
                    "evidence_ref": { "type": "null" }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": { "current_rating": { "type": "object", "properties": { "claim_outcome": { "enum": ["MET", "NOT MET"] } }, "required": ["claim_outcome"] } }
            },
            "then": {
              "properties": {
                "current_rating": {
                  "type": "object",
                  "properties": {
                    "environment_assurance": { "not": { "const": "NOT ESTABLISHED" } },
                    "evidence_ref": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "current_rating": {
                  "type": "object",
                  "properties": { "environment_assurance": { "enum": ["DEV VERIFIED", "STAGING VERIFIED", "PRODUCTION OBSERVED"] } },
                  "required": ["environment_assurance"]
                }
              }
            },
            "then": {
              "properties": {
                "current_rating": {
                  "type": "object",
                  "properties": { "evidence_ref": { "type": "string", "minLength": 1 } }
                }
              }
            }
          },
          {
            "if": {
              "properties": { "current_rating": { "type": "object", "properties": { "review_assurance": { "const": "NOT REVIEWED" } }, "required": ["review_assurance"] } }
            },
            "then": {
              "properties": { "current_rating": { "type": "object", "properties": { "review_evidence_ref": { "type": "null" } } } }
            },
            "else": {
              "properties": { "current_rating": { "type": "object", "properties": { "review_evidence_ref": { "type": "string", "minLength": 1 } } } }
            }
          }
        ]
      }
    }
  }
}
