# Mutable allowlist for JobsMain. Its systemd unit pins APP_ENV=production and
# JOB_RUNTIME_PROFILE=full. Every REF must resolve inside the isolated full namespace.
SERVICE_VERSION=replace-with-staging-release-commit
DATABASE_JOB_CONNECTION_REF=zhudatuan/staging/full/database/jobs
REDIS_CONNECTION_REF=zhudatuan/staging/full/redis/jobs
SECRET_STORE_ENDPOINT=https://127.0.0.1:8643
SECRET_STORE_BEARER_TOKEN=REPLACE_FULL_JOBS_SECRET_BEARER_TOKEN_00000000000000003
EXTENSION_MANIFEST_KEY_REF=zhudatuan/staging/full/extensions/manifest
KMS_ENDPOINT=https://127.0.0.1:8644
KMS_BEARER_TOKEN=REPLACE_FULL_JOBS_KMS_BEARER_TOKEN_0000000000000000006
WECHAT_APPLICATION_CONFIG_REF=zhudatuan/staging/full/wechat/applications
WECHAT_PAYMENT_CONFIG_REF=zhudatuan/staging/full/payment/wechat
INVOICE_CONFIG_REF=zhudatuan/staging/full/invoice/provider
PAYOUT_CONFIG_REF=zhudatuan/staging/full/payout/provider
NOTIFICATION_CONFIG_REF=zhudatuan/staging/full/notification/providers
OBJECT_STORE_ENDPOINT=https://127.0.0.1:8645
OBJECT_STORE_TOKEN_REF=zhudatuan/staging/full/objects/jobs
JOB_WORKER_ID=zhudatuan-staging-full-jobs-01
NODE_EXTRA_CA_CERTS=/opt/zhudatuan-staging-full/shared/tls/internal-ca.crt
