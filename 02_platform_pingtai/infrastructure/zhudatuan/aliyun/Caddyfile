{
	servers {
		# Only Cloudflare may supply the client address used by the application.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP
	}
}

www.zhudatuan.com {
	redir https://zhudatuan.com{uri} permanent
}

zhudatuan.com {
	encode gzip

	header {
		Content-Security-Policy "frame-ancestors 'self'; form-action 'self' https://accounts.zhudatuan.com https://console.zhudatuan.com; base-uri 'self'; object-src 'none'"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
	}

	# Optional same-origin login drawer. Its frame policy deliberately differs
	# from the standalone accounts host.
	redir /login /login/ 308

	handle_path /login/* {
		root * /opt/zhudatuan/current/01_core_hexin/apps/auth-web/dist
		try_files {path} /index.html
		file_server
	}

	handle {
		reverse_proxy localhost:3000 {
			header_up X-Real-IP {client_ip}
		}
	}
}

accounts.zhudatuan.com {
	encode gzip

	header {
		Content-Security-Policy "frame-ancestors 'none'; form-action https://zhudatuan.com https://console.zhudatuan.com; base-uri 'none'; object-src 'none'"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	@authApi path /api/v1/auth/*
	handle @authApi {
		reverse_proxy localhost:3000 {
			header_up X-Real-IP {client_ip}
		}
	}

	handle {
		root * /opt/zhudatuan/current/01_core_hexin/apps/auth-web/dist
		try_files {path} /index.html
		file_server
	}
}

console.zhudatuan.com {
	encode gzip

	header {
		Content-Security-Policy "frame-ancestors 'none'; form-action 'self' https://accounts.zhudatuan.com; base-uri 'self'; object-src 'none'"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	# Only the compatibility identity/session endpoints are same-host here.
	# The Console's business API remains the separately configured Canonical API.
	@compatAuth path /api/v1/auth/*
	handle @compatAuth {
		reverse_proxy localhost:3000 {
			header_up X-Real-IP {client_ip}
		}
	}

	@previewAssets path /design-references/* /demo/*
	handle @previewAssets {
		header Cache-Control "no-store"
		respond "Not Found" 404
	}

	handle {
		root * /opt/zhudatuan/current/01_core_hexin/apps/console/dist
		try_files {path} /index.html
		file_server
	}
}

api.zhudatuan.com {
	encode gzip

	header {
		Cache-Control "no-store"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	reverse_proxy localhost:3001 {
		header_up X-Real-IP {client_ip}
	}
}

media.zhudatuan.com {
	encode gzip

	header {
		Access-Control-Allow-Origin "*"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
	}

	root * /opt/zhudatuan/media
	file_server
}

chat.zhudatuan.com {
	header {
		Cache-Control "no-store"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Robots-Tag "noindex, nofollow, noarchive"
	}

	respond "Service Unavailable" 503
}

labs.zhudatuan.com {
	encode gzip

	header {
		Content-Security-Policy "frame-ancestors 'self' https://console.zhudatuan.com; form-action 'none'; base-uri 'self'; object-src 'none'"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Robots-Tag "noindex, nofollow, noarchive"
	}

	@compatibilityApi path /api/health /api/v1/*
	handle @compatibilityApi {
		header Cache-Control "no-store"
		respond "Not Found" 404
	}

	@consoleReferences path /design-references/* /demo/*
	handle @consoleReferences {
		header Cache-Control "no-store"
		root * /opt/zhudatuan/current/01_core_hexin/apps/console/dist
		file_server
	}

	handle {
		header Cache-Control "no-store"
		respond "Not Found" 404
	}
}
