{
  "schema": "ai.delivery.aliyun-ram-policy-template.v1",
  "placeholders": ["${ACCOUNT_ID}", "${BUCKET}", "${PROJECT_PREFIX}"],
  "roles": {
    "observer": { "actions": ["oss:GetObject", "oss:ListObjects"], "resources": ["acs:oss:*:${ACCOUNT_ID}:${BUCKET}/${PROJECT_PREFIX}/*"] },
    "builder": { "actions": ["oss:GetObject", "oss:PutObject", "oss:ListObjects"], "resources": ["acs:oss:*:${ACCOUNT_ID}:${BUCKET}/${PROJECT_PREFIX}/runner-routing/*", "acs:oss:*:${ACCOUNT_ID}:${BUCKET}/${PROJECT_PREFIX}/*/artifacts/*", "acs:oss:*:${ACCOUNT_ID}:${BUCKET}/${PROJECT_PREFIX}/*/release-*.json", "acs:oss:*:${ACCOUNT_ID}:${BUCKET}/${PROJECT_PREFIX}/*/seals/v1/*/uploaded.json"] },
    "releaser": { "actions": ["oss:GetObject", "oss:PutObject", "oss:ListObjects"], "resources": ["acs:oss:*:${ACCOUNT_ID}:${BUCKET}/${PROJECT_PREFIX}/*/seals/v1/*", "acs:oss:*:${ACCOUNT_ID}:${BUCKET}/${PROJECT_PREFIX}/*/deployments/*", "acs:oss:*:${ACCOUNT_ID}:${BUCKET}/${PROJECT_PREFIX}/*/artifacts/*", "acs:oss:*:${ACCOUNT_ID}:${BUCKET}/${PROJECT_PREFIX}/*/release-*.json"] }
  },
  "constraints": { "wildcardActionForbidden": true, "bucketWideResourceForbidden": true, "immutableWritesRequireForbidOverwrite": true }
}
