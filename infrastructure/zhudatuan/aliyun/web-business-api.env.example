# Exact mutable allowlist for zhudatuan-web-api.service. Profile, host and port are pinned by systemd Environment.
APP_ENV=production
AUTH_MODE=membership
SERVICE_VERSION=replace-with-release-commit
API_ALLOWED_ORIGINS=https://console.zhudatuan.com,https://zhudatuan.com
DATABASE_API_CONNECTION_REF=zhudatuan/web-business/database/api
KMS_ENDPOINT=https://127.0.0.1:8544
KMS_BEARER_TOKEN=REPLACE_WITH_THE_WEB_BUSINESS_KMS_BEARER_TOKEN!
SECRET_STORE_ENDPOINT=https://127.0.0.1:8543
SECRET_STORE_BEARER_TOKEN=REPLACE_WITH_THE_WEB_BUSINESS_SECRET_STORE_BEARER_TOKEN!
NODE_EXTRA_CA_CERTS=/opt/zhudatuan/shared/tls/internal-ca.crt
