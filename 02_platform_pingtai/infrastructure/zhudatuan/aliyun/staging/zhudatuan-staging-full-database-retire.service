[Unit]
Description=Zhudatuan full staging retire one-shot database principals
Wants=network-online.target
Requires=zhudatuan-staging-full-postgres-proxy.service zhudatuan-staging-full-owner-bootstrap.service
After=network-online.target zhudatuan-staging-full-postgres-proxy.service zhudatuan-staging-full-owner-bootstrap.service
Before=zhudatuan-staging-full-identity-api.service zhudatuan-staging-full-identity-notification-jobs.service zhudatuan-staging-full-jobs.service
ConditionPathExists=/opt/zhudatuan-staging-full/current/infrastructure/zhudatuan/aliyun/postgres-retire-registration-bootstrap.sql
ConditionPathExists=/run/zhudatuan-staging-full/database-retire.env
ConditionPathExists=/usr/bin/psql

[Service]
Type=oneshot
RemainAfterExit=yes
DynamicUser=yes
User=zdt-stg-full-retire
WorkingDirectory=/opt/zhudatuan-staging-full/current
EnvironmentFile=/run/zhudatuan-staging-full/database-retire.env
UnsetEnvironment=PGSERVICE PGSERVICEFILE
ExecStartPre=/usr/bin/pg_isready --host=127.0.0.1 --port=55442 --dbname=zhudatuan_registration --timeout=5
ExecStart=/usr/bin/env PGHOST=127.0.0.1 PGHOSTADDR=127.0.0.1 PGPORT=55442 PGDATABASE=zhudatuan_registration \
  PGSSLMODE=disable PGCONNECT_TIMEOUT=5 PGPASSFILE=/dev/null \
  /usr/bin/psql --set ON_ERROR_STOP=1 --file 02_platform_pingtai/infrastructure/zhudatuan/aliyun/postgres-retire-registration-bootstrap.sql
TimeoutStartSec=120
RuntimeDirectory=zdt-stg-full-retire
RuntimeDirectoryMode=0700
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zhudatuan-staging-full-database-retire
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
KeyringMode=private
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SocketBindDeny=any
IPAddressDeny=any
IPAddressAllow=localhost
ReadOnlyPaths=/opt/zhudatuan-staging-full/current
InaccessiblePaths=-/opt/zhudatuan-staging-full/shared -/opt/zhudatuan -/opt/smart-wing -/opt/smart-wiston -/opt/shop-test

# Manual one-shot only; there is intentionally no [Install] section.
