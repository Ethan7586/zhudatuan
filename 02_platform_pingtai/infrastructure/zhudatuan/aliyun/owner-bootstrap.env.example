APP_ENV=production
ZHUDATUAN_OWNER_BOOTSTRAP_CONFIRM=CREATE_ONE_ZHUDATUAN_CONSOLE_OWNER_ETHAN
ZHUDATUAN_OWNER_BOOTSTRAP_DATABASE_URL=postgresql://zhudatuanbootstrap:replace-with-dedicated-password@127.0.0.1:55432/zhudatuan_registration
ZHUDATUAN_OWNER_BOOTSTRAP_DATABASE_NAME=zhudatuan_registration
ZHUDATUAN_OWNER_BOOTSTRAP_SENTINEL=copy-the-exact-random-value-from-postgres-env
ZHUDATUAN_OWNER_BOOTSTRAP_ACTOR=owner:Ethan
ZHUDATUAN_OWNER_PASSWORD_REF=zhudatuan/registration/owner/password
IDENTITY_KEY_REF=zhudatuan/registration/identity/index
SECRET_STORE_ENDPOINT=https://127.0.0.1:8543
SECRET_STORE_BEARER_TOKEN=REPLACE_WITH_THE_RUNTIME_SECRET_STORE_BEARER_TOKEN!
NODE_EXTRA_CA_CERTS=/opt/zhudatuan/shared/tls/internal-ca.crt
