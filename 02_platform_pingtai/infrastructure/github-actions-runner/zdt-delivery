#!/usr/bin/env bash
# Control-side Runner 1.7 entry. It only loads the latest control plane and dispatches GitHub Actions.
set -euo pipefail

operation="${1:-}"
export ZDT_DELIVERY_STARTED_MS="$(($(date +%s) * 1000))"
case "$operation" in
  release|retry)
    { [ "$#" -eq 2 ] || [ "$#" -eq 4 ]; } || { echo "Usage: zdt-delivery $operation <full-source-sha-or-release-id> [target physical-node]" >&2; exit 64; }
    ;;
  deploy)
    { [ "$#" -eq 2 ] || [ "$#" -eq 4 ]; } || { echo 'Usage: zdt-delivery deploy <full-source-sha> | deploy <target> <full-source-sha> <physical-node>' >&2; exit 64; }
    if [ "$#" -eq 4 ]; then
      set -- release "$3" "$2" "$4"
    else
      set -- release "$2"
    fi
    ;;
  status)
    [ "$#" -eq 2 ] || { echo 'Usage: zdt-delivery status <full-source-sha-or-release-id>' >&2; exit 64; }
    ;;
  rollback)
    [ "$#" -eq 3 ] || { echo 'Usage: zdt-delivery rollback <target> <physical-node>' >&2; exit 64; }
    ;;
  control-update)
    [ "$#" -eq 1 ] || { echo 'Usage: zdt-delivery control-update' >&2; exit 64; }
    ;;
  *)
    echo 'Usage: zdt-delivery release <full-source-sha> [target physical-node]' >&2
    echo '       zdt-delivery deploy <full-source-sha> | deploy <target> <full-source-sha> <physical-node>' >&2
    echo '       zdt-delivery status <full-source-sha-or-release-id>' >&2
    echo '       zdt-delivery retry <release-id> [target physical-node]' >&2
    echo '       zdt-delivery rollback <target> <physical-node>' >&2
    echo '       zdt-delivery control-update' >&2
    exit 64
    ;;
esac

if [ -n "${ZDT_GIT_ANCHOR:-}" ]; then
  repository_root="$ZDT_GIT_ANCHOR"
else
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
  repository_root="$(git -C "$script_dir" rev-parse --show-toplevel 2>/dev/null || git rev-parse --show-toplevel 2>/dev/null)" \
    || { echo 'Run zdt-delivery from a repository checkout or set ZDT_GIT_ANCHOR.' >&2; exit 1; }
fi
git -C "$repository_root" rev-parse --git-dir >/dev/null 2>&1 || { echo "Git anchor unavailable: $repository_root" >&2; exit 1; }
tmp_base="${TMPDIR:-/tmp}"
control_parent="$(mktemp -d "${tmp_base%/}/zdt-delivery-control.XXXXXX")"
control_root="$control_parent/zdt-next"
added=false
cleanup() {
  if [ "$added" = true ]; then git -C "$repository_root" worktree remove --force "$control_root" >/dev/null 2>&1 || true; fi
  rmdir "$control_parent" >/dev/null 2>&1 || true
}
trap cleanup EXIT
git -C "$repository_root" fetch origin zdt-next --quiet
control_sha="$(git -C "$repository_root" rev-parse origin/zdt-next)"
git -C "$repository_root" worktree add --detach "$control_root" "$control_sha" --quiet
added=true
printf 'Delivery control: %s\n' "$control_sha"
(cd "$control_root" && bash scripts/delivery-dispatch.sh "$@")
