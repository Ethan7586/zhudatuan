www.zhudatuan.com {
	redir https://zhudatuan.com{uri} permanent
}

zhudatuan.com {
	encode gzip

	header {
		Content-Security-Policy "frame-ancestors 'self'; form-action 'self' https://accounts.zhudatuan.com https://console.zhudatuan.com; base-uri 'self'; object-src 'none'"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
	}

	@productionShowcases path /desktop-1920 /laptop-web /mini-program /android-app /tablet-app
	handle @productionShowcases {
		header Cache-Control "no-store"
		respond "Not Found" 404
	}

	# Optional same-origin login drawer. Its frame policy deliberately differs
	# from the standalone accounts host.
	redir /login /login/ 308

	handle_path /login/* {
		root * /opt/zhudatuan/current/apps/auth-web/dist
		try_files {path} /index.html
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:4310 {
			header_up X-Real-IP {client_ip}
		}
	}
}

accounts.zhudatuan.com {
	encode gzip

	header {
		Content-Security-Policy "frame-ancestors 'none'; form-action https://zhudatuan.com https://console.zhudatuan.com; base-uri 'none'; object-src 'none'"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	# Never let the static SPA fallback turn an API request into index.html 200.
	@accountsApi path /api /api/*
	handle @accountsApi {
		respond "Not Found" 404
	}

	handle {
		root * /opt/zhudatuan/current/apps/auth-web/dist
		try_files {path} /index.html
		file_server
	}
}

console.zhudatuan.com {
	encode gzip

	header {
		Content-Security-Policy "frame-ancestors 'none'; form-action 'self' https://accounts.zhudatuan.com; base-uri 'self'; object-src 'none'"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	@previewAssets path /design-references/* /demo/*
	handle @previewAssets {
		header Cache-Control "no-store"
		respond "Not Found" 404
	}

	# Preview requests keep the public API paths generated by the SDK. Route them
	# by their same-origin preview referrer so the production Console never reads
	# display-only fixtures.
	@referralPreviewRequest {
		header Referer https://console.zhudatuan.com/referral-preview/*
		path /api /api/* /health /health/*
	}
	handle @referralPreviewRequest {
		header Cache-Control "no-store"
		reverse_proxy 127.0.0.1:4312
	}

	@referralPreviewApi path /api/v1/identity/session /api/v1/members/me /api/v1/referral/*
	handle @referralPreviewApi {
		header Cache-Control "no-store"
		reverse_proxy 127.0.0.1:4312
	}

	handle_path /referral-preview/* {
		header Cache-Control "no-store"
		header X-Robots-Tag "noindex, nofollow, noarchive"
		root * /srv/zhudatuan-display/referral-current/apps/console/dist
		try_files {path} /index.html
		file_server
	}

	handle {
		root * /opt/zhudatuan/current/apps/console/dist
		try_files {path} /index.html
		file_server
	}
}

api.zhudatuan.com {
	encode gzip

	header {
		Cache-Control "no-store"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	@registrationHealth {
		method GET
		path /health/live /health/ready /health/startup
	}
	handle @registrationHealth {
		reverse_proxy 127.0.0.1:4321 {
			header_up X-Real-IP {client_ip}
		}
	}

	@registrationPreflight {
		method OPTIONS
		path /api/v1/identity/sessions /api/v1/identity/tickets/exchange /api/v1/identity/session /api/v1/identity/challenges /api/v1/identity/invitations /api/v1/identity/invitations/* /api/v1/identity/invitations/resolve /api/v1/identity/members /api/v1/members /api/v1/access/center
	}
	handle @registrationPreflight {
		reverse_proxy 127.0.0.1:4321 {
			header_up X-Real-IP {client_ip}
		}
	}

	@registrationPost {
		method POST
		path /api/v1/identity/sessions /api/v1/identity/tickets/exchange /api/v1/identity/challenges /api/v1/identity/invitations /api/v1/identity/invitations/resolve /api/v1/identity/members
	}
	handle @registrationPost {
		reverse_proxy 127.0.0.1:4321 {
			header_up X-Real-IP {client_ip}
		}
	}

	@registrationSessionRead {
		method GET
		path /api/v1/identity/session
	}
	handle @registrationSessionRead {
		reverse_proxy 127.0.0.1:4321 {
			header_up X-Real-IP {client_ip}
		}
	}

	@registrationSessionDelete {
		method DELETE
		path /api/v1/identity/session
	}
	handle @registrationSessionDelete {
		reverse_proxy 127.0.0.1:4321 {
			header_up X-Real-IP {client_ip}
		}
	}

	@registrationInvitationDelete {
		method DELETE
		path /api/v1/identity/invitations/*
	}
	handle @registrationInvitationDelete {
		reverse_proxy 127.0.0.1:4321 {
			header_up X-Real-IP {client_ip}
		}
	}

	@registrationOperatorRead {
		method GET
		path /api/v1/members /api/v1/access/center
	}
	handle @registrationOperatorRead {
		reverse_proxy 127.0.0.1:4321 {
			header_up X-Real-IP {client_ip}
		}
	}

	# Mall creation is a single selected Console command on its own runtime.
	# Exact method and path matching prevents any future Provisioning operation
	# from becoming reachable merely because it shares the module name.
	@mallProvisioningPreflight {
		method OPTIONS
		path /api/v1/provisioning/malls
	}
	handle @mallProvisioningPreflight {
		reverse_proxy 127.0.0.1:4325 {
			header_up X-Real-IP {client_ip}
		}
	}

	@mallProvisioningApi {
		method POST
		path /api/v1/provisioning/malls
	}
	handle @mallProvisioningApi {
		reverse_proxy 127.0.0.1:4325 {
			header_up X-Real-IP {client_ip}
		}
	}

	@mallProvisioningRead {
		method GET
		path /api/v1/provisioning/malls/*
	}
	handle @mallProvisioningRead {
		reverse_proxy 127.0.0.1:4325 {
			header_up X-Real-IP {client_ip}
		}
	}

	# Purchase commands have an independent runtime and database role. Match both
	# method and exact path before the read-oriented WebBusiness surface because
	# GET /api/v1/orders remains owned by WebBusiness on 4322.
	# Public purchase traffic stays fail-closed until a real PostgreSQL E2E receipt
	# is reviewed in a later code change. Loopback 4323 remains available for E2E.
	@purchasePublicBlocked {
		method POST OPTIONS
		path /api/v1/checkouts/quotes /api/v1/orders /api/v1/payments/intents
	}
	handle @purchasePublicBlocked {
		header Cache-Control "no-store"
		respond "Purchase cutover blocked" 503
	}

	@purchasePreflight {
		method OPTIONS
		path /api/v1/checkouts/quotes /api/v1/orders /api/v1/payments/intents
	}
	handle @purchasePreflight {
		reverse_proxy 127.0.0.1:4323 {
			header_up X-Real-IP {client_ip}
		}
	}

	@purchaseApi {
		method POST
		path /api/v1/checkouts/quotes /api/v1/orders /api/v1/payments/intents
	}
	handle @purchaseApi {
		reverse_proxy 127.0.0.1:4323 {
			header_up X-Real-IP {client_ip}
		}
	}

	# WeChat Pay callbacks have a single provider-only runtime and exact route.
	@paymentWebhookApi {
		method POST
		path /api/v1/webhooks/wechat/payment
	}
	handle @paymentWebhookApi {
		reverse_proxy 127.0.0.1:4326 {
			header_up X-Real-IP {client_ip}
		}
	}

	# Console Support is an independent least-privilege runtime. Keep method and
	# path matching explicit so no other Commerce operation becomes public.
	@consoleSupportPreflight {
		method OPTIONS
		path /api/v1/support/cases /api/v1/support/cases/*/messages
	}
	handle @consoleSupportPreflight {
		reverse_proxy 127.0.0.1:4324 {
			header_up X-Real-IP {client_ip}
		}
	}

	@consoleSupportRead {
		method GET
		path /api/v1/support/cases /api/v1/support/cases/*/messages
	}
	handle @consoleSupportRead {
		reverse_proxy 127.0.0.1:4324 {
			header_up X-Real-IP {client_ip}
		}
	}

	@consoleSupportSend {
		method POST
		path /api/v1/support/cases/*/messages
	}
	handle @consoleSupportSend {
		reverse_proxy 127.0.0.1:4324 {
			header_up X-Real-IP {client_ip}
		}
	}

	# The WebBusiness process is deliberately narrower than the Canonical API
	# contract. Keep every public path explicit so an added operation cannot
	# become reachable merely because it shares an /api/v1 prefix.
	@webBusinessApi path /api/v1/members/me /api/v1/members/me/addresses /api/v1/members/me/addresses/* /api/v1/organizations/layers /api/v1/reports/dashboard /api/v1/catalog/listings /api/v1/pricing/offers /api/v1/inventory/availability /api/v1/carts/current /api/v1/carts/current/* /api/v1/benefits/accounts /api/v1/benefits/ledgers /api/v1/orders
	handle @webBusinessApi {
		reverse_proxy 127.0.0.1:4322 {
			header_up X-Real-IP {client_ip}
		}
	}

	handle {
		respond "Not Found" 404
	}
}

media.zhudatuan.com {
	encode gzip

	header {
		Access-Control-Allow-Origin "*"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
	}

	root * /opt/zhudatuan/media
	file_server
}

