# Copy to /opt/zhudatuan-staging/shared/.env.staging with mode 0600.
# Values below are non-secret placeholders. Every reference must resolve only to
# isolated staging resources; never paste database passwords or access keys here.
APP_ENV=production
AUTH_MODE=membership
SERVICE_VERSION=replace-with-staging-release-id
API_PORT=3101
API_ALLOWED_ORIGINS=https://accounts.staging.example.invalid,https://console.staging.example.invalid
AUTH_RETURN_TARGETS={"console":"https://console.staging.example.invalid","console-hbbtzn":"https://console.staging.example.invalid","storefront":"https://disabled.staging.example.invalid","storefront-hbbtzn":"https://disabled.staging.example.invalid","store":"https://disabled.staging.example.invalid","supplier":"https://disabled.staging.example.invalid"}
DATABASE_API_CONNECTION_REF=shop/staging/database/api
DATABASE_JOB_CONNECTION_REF=shop/staging/database/jobs
REDIS_CONNECTION_REF=shop/staging/redis/runtime
SECRET_STORE_ENDPOINT=https://secrets.staging.example.invalid
SESSION_KEY_REF=shop/staging/session/key
IDENTITY_KEY_REF=shop/staging/identity/key
QUOTE_KEY_REF=shop/staging/quote/key
PII_KEY_REF=shop/staging/pii/key
EXTENSION_MANIFEST_KEY_REF=shop/staging/extensions/manifest
KMS_ENDPOINT=https://kms.staging.example.invalid
WECHAT_APPLICATION_CONFIG_REF=shop/staging/wechat/applications
WECHAT_PAYMENT_CONFIG_REF=shop/staging/payment/wechat
WECHAT_IDENTITY_CONFIG_REF=shop/staging/wechat/identity
INVOICE_CONFIG_REF=shop/staging/invoice/provider
PAYOUT_CONFIG_REF=shop/staging/payout/provider
NOTIFICATION_CONFIG_REF=shop/staging/notification/aliyun
OBJECT_STORE_ENDPOINT=https://objects.staging.example.invalid
OBJECT_STORE_TOKEN_REF=shop/staging/objects/runtime
PUBLIC_MEDIA_BASE_URL=https://media.staging.example.invalid
PUBLIC_MALL_SLUG=staging
JOB_WORKER_ID=zhudatuan-staging-worker-01
