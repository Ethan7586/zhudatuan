{
  "schema": "ai.delivery.role-capabilities.v1",
  "roles": {
    "observer": {
      "allows": ["github:runners:read", "github:mainline:read", "github:closures:read", "oss:release-index:get", "oss:seal:get", "oss:receipt:get", "oss:bounded-prefix:list"],
      "denies": ["oss:write", "ssh:physical-target:deploy"]
    },
    "builder": {
      "allows": ["github:runners:read", "oss:runner-request:get-put", "oss:slot-claim:get-put", "oss:artifact:get-put", "oss:provenance:put", "oss:uploaded-receipt:put", "oss:bounded-prefix:list"],
      "denies": ["oss:final-seal:put", "oss:writer-lease:put", "oss:deployment-receipt:put", "ssh:physical-target:deploy"]
    },
    "releaser": {
      "allows": ["github:runners:read", "oss:artifact:get", "oss:seal:get-put", "oss:writer-lease:get-put", "oss:validation-receipt:put", "oss:deployment-receipt:put", "oss:bounded-prefix:list", "ssh:physical-target:deploy"],
      "denies": ["source:build", "dependency:install", "oss:artifact:put", "oss:provenance:put"]
    }
  }
}
