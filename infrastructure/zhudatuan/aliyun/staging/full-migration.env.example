# One-shot MigrationMain environment, loaded only by its manual systemd service.
MIGRATION_APPROVAL=hard-cut-20260821054000
MIGRATION_DATABASE_CONNECTION_REF=zhudatuan/staging/full/database/migration
MIGRATION_DIRECTORY=/opt/zhudatuan-staging-full/current/database/supabase/migrations
MIGRATION_DISTRIBUTOR_KEY_REF=channel/distributor
