# Mutable allowlist for the full profile's registration-only public API. Its systemd
# unit pins APP_ENV=test, AUTH_MODE=membership, profile, bind host, and port.
SERVICE_VERSION=replace-with-staging-release-commit
API_ALLOWED_ORIGINS=https://accounts.full.staging.example.invalid,https://console.full.staging.example.invalid
AUTH_RETURN_TARGETS='{"console":"https://console.full.staging.example.invalid","storefront":"https://disabled.full.staging.example.invalid","store":"https://console.full.staging.example.invalid/entrances/store","supplier":"https://console.full.staging.example.invalid/entrances/supplier"}'
DATABASE_API_CONNECTION_REF=zhudatuan/staging/full/database/identity-api
SESSION_KEY_REF=zhudatuan/staging/full/identity/session
IDENTITY_KEY_REF=zhudatuan/staging/full/identity/index
SECRET_STORE_ENDPOINT=https://127.0.0.1:8643
SECRET_STORE_BEARER_TOKEN=REPLACE_FULL_API_SECRET_BEARER_TOKEN_000000000000000001
KMS_ENDPOINT=https://127.0.0.1:8644
KMS_BEARER_TOKEN=REPLACE_FULL_API_KMS_BEARER_TOKEN_000000000000000000004
NODE_EXTRA_CA_CERTS=/opt/zhudatuan-staging-full/shared/tls/internal-ca.crt
