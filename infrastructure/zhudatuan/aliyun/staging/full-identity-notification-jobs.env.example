# Full-staging Owner invitation OTP worker. Its systemd unit pins APP_ENV=production
# and JOB_RUNTIME_PROFILE=identity-notification-only. It has no Full Jobs provider refs.
SERVICE_VERSION=replace-with-staging-release-commit
DATABASE_JOB_CONNECTION_REF=zhudatuan/staging/full/database/identity-notification-jobs
SECRET_STORE_ENDPOINT=https://127.0.0.1:8643
SECRET_STORE_BEARER_TOKEN=REPLACE_FULL_IDENTITY_JOBS_SECRET_BEARER_TOKEN_000000002
IDENTITY_NOTIFICATION_CONFIG_REF=zhudatuan/staging/full/notification/identity-sms
KMS_ENDPOINT=https://127.0.0.1:8644
KMS_BEARER_TOKEN=REPLACE_FULL_IDENTITY_JOBS_KMS_BEARER_TOKEN_00000000005
JOB_WORKER_ID=zhudatuan-staging-full-identity-notification-jobs-01
NODE_EXTRA_CA_CERTS=/opt/zhudatuan-staging-full/shared/tls/internal-ca.crt
