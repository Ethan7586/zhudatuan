# Exact mutable allowlist for zhudatuan-purchase-api.service. Profile, host and port are pinned by systemd.
APP_ENV=production
AUTH_MODE=membership
SERVICE_VERSION=replace-with-release-commit
API_ALLOWED_ORIGINS=https://hbbtzn.com,https://mall.hbbtzn.com,https://www.hbbtzn.com,https://zhudatuan.com
DATABASE_API_CONNECTION_REF=zhudatuan/purchase/database/api
QUOTE_KEY_REF=zhudatuan/purchase/checkout/quote
SECRET_STORE_ENDPOINT=https://127.0.0.1:8543
SECRET_STORE_BEARER_TOKEN=REPLACE_WITH_THE_PURCHASE_SECRET_STORE_BEARER_TOKEN!
KMS_ENDPOINT=https://127.0.0.1:8544
KMS_BEARER_TOKEN=REPLACE_WITH_THE_PURCHASE_KMS_BEARER_TOKEN!
WECHAT_APPLICATION_CONFIG_REF=zhudatuan/purchase/wechat/applications
WECHAT_PAYMENT_CONFIG_REF=zhudatuan/purchase/payment/wechat
NODE_EXTRA_CA_CERTS=/opt/zhudatuan/shared/tls/internal-ca.crt
