{
  "name": "@shop/contract",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "build": "npm run typecheck",
    "test": "vitest run"
  },
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/ClientSchema.ts",
    "./error": "./src/ErrorSchema.ts",
    "./errors": "./src/ErrorContract.ts",
    "./identityschema": "./src/operations/IdentityClientSchemas.ts",
    "./http": "./src/HttpContract.ts",
    "./ids": "./src/OperationIds.ts",
    "./policies": "./src/OperationPolicyCatalog.ts",
    "./fingerprint": "./src/OperationFingerprint.ts",
    "./schema": "./src/schema/index.ts",
    "./schema/*": "./src/schema/*Schema.ts",
    "./operationschema": "./src/schema/OperationSchema.ts",
    "./version": "./src/ContractIdentity.ts",
    "./openapi.json": "./openapi.json",
    "./order": "./src/OrderContract.ts",
    "./voucher": "./src/VoucherCredential.ts",
    "./vocabulary": "./src/Vocabulary.ts",
    "./events.json": "./events.json",
    "./catalog-taxonomy.json": "./src/catalog-taxonomy.json"
  },
  "types": "./src/index.ts",
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
