{
	admin off
	auto_https off
}

https://:4430 {
	tls /opt/sfl/nodes/hbbtzn-l1/runtime/tls/origin.crt /opt/sfl/nodes/hbbtzn-l1/runtime/tls/origin.key
	encode gzip

	@ordersReadPreflight {
		host api.hbbtzn.com
		method OPTIONS
		path /api/v1/orders /api/v1/orders/*
		header Access-Control-Request-Method GET
	}
	handle @ordersReadPreflight {
		reverse_proxy 127.0.0.1:4322 {
			header_up Host {http.request.host}
			header_up X-Real-IP {http.request.header.CF-Connecting-IP}
			header_up -X-Sfl-Node-Id
			header_up -X-Sfl-Node-Manifest-Id
			header_up -X-Sfl-Node-Surface
			header_up -X-Zdt-Identity-Entry-Host
		}
	}

