[Unit]
Description=SFL node-bound Mall Provisioning API (%i)
Requires=sfl-secret-store@%i.service docker.service
After=network-online.target zhudatuan-migration.service sfl-secret-store@%i.service docker.service
ConditionPathExists=/opt/sfl/nodes/%i/targets/mall-provisioning-api/current/service/MallProvisioningApiMain.js
ConditionPathExists=/opt/sfl/nodes/%i/targets/mall-provisioning-api/current/service/MallProvisioningApiReadyMain.js
ConditionPathExists=/opt/sfl/nodes/%i/runtime/mall-provisioning-api.env

[Service]
Type=simple
User=zhudatuan
Group=zhudatuan
WorkingDirectory=/opt/sfl/nodes/%i/targets/mall-provisioning-api/current
Environment=NODE_ENV=production
Environment=MALL_PROVISIONING_API_PROFILE=mall-provisioning-only
Environment=API_PORT=4325
Environment=API_BIND_HOST=127.0.0.1
EnvironmentFile=/opt/sfl/nodes/%i/runtime/mall-provisioning-api.env
ExecStart=/usr/bin/env MALL_PROVISIONING_API_PROFILE=mall-provisioning-only API_PORT=4325 API_BIND_HOST=127.0.0.1 /usr/bin/node service/MallProvisioningApiMain.js
ExecStartPost=/usr/bin/env MALL_PROVISIONING_API_PROFILE=mall-provisioning-only API_PORT=4325 API_BIND_HOST=127.0.0.1 /usr/bin/node service/MallProvisioningApiReadyMain.js
Restart=on-failure
RestartSec=3
TimeoutStartSec=30
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
PrivateDevices=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/opt/sfl/nodes/%i /opt/zhudatuan/shared
InaccessiblePaths=-/opt/smart-wing -/opt/smart-wiston -/opt/shop-test

[Install]
WantedBy=multi-user.target
