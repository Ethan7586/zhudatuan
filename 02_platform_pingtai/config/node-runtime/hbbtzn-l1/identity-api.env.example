APP_ENV=production
AUTH_MODE=membership
SERVICE_VERSION=replace-with-release-source-sha
API_PORT=4433
API_ALLOWED_ORIGINS=https://accounts.fufuwang.com.cn,https://console.fufuwang.com.cn,https://h5.fufuwang.com.cn,https://h6.fufuwang.com.cn,https://fufuwang.com.cn,https://mall.fufuwang.com.cn,https://www.fufuwang.com.cn
DATABASE_API_CONNECTION_REF=hbbtzn/nodes/l1/database/identity-api
DATABASE_API_ROLE=zhudatuanidentityapi
SESSION_KEY_REF=hbbtzn/nodes/l1/identity/session
IDENTITY_KEY_REF=hbbtzn/nodes/l1/identity/index
WECHAT_APPLICATION_CONFIG_REF=hbbtzn/nodes/l1/identity/wechat-applications
WECHAT_IDENTITY_CONFIG_REF=hbbtzn/nodes/l1/identity/wechat
KMS_ENDPOINT=https://127.0.0.1:8544
KMS_BEARER_TOKEN=REPLACE_WITH_L1_IDENTITY_KMS_TOKEN
OBJECT_STORE_ENDPOINT=https://127.0.0.1:8655
OBJECT_STORE_BEARER_TOKEN=REPLACE_WITH_L1_IDENTITY_OBJECT_STORE_TOKEN
SECRET_STORE_ENDPOINT=https://127.0.0.1:8543
SECRET_STORE_BEARER_TOKEN=REPLACE_WITH_L1_IDENTITY_SECRET_STORE_TOKEN
NODE_MANIFEST_PATH=/opt/sfl/nodes/hbbtzn-l1/manifest.json
NODE_MANIFEST_ID=manifest:hbbtzn:l1:v1
NODE_MANIFEST_DIGEST=sha256:REPLACE_WITH_GENERATED_DIGEST
NODE_RUNTIME_INSTANCE_ID=runtime:hbbtzn:l1:commerce
NODE_RUNTIME_CONFIG_REF=sfl/nodes/hbbtzn-l1/runtime/v1
NODE_RESOURCE_BINDING_VERSION=1
NODE_RELEASE_POINTER_REF=/opt/sfl/nodes/hbbtzn-l1/current
NODE_EXTRA_CA_CERTS=/opt/zhudatuan/shared/tls/internal-ca.crt
