# Exact mutable allowlist for sfl-identity-notification-jobs@hbbtzn-l1.service.
APP_ENV=production
SERVICE_VERSION=replace-with-release-commit
DATABASE_JOB_CONNECTION_REF=hbbtzn/nodes/l1/database/identity-notification-jobs
SECRET_STORE_ENDPOINT=https://127.0.0.1:8543
SECRET_STORE_BEARER_TOKEN=REPLACE_WITH_THE_HBBTZN_IDENTITY_NOTIFICATION_SECRET_STORE_BEARER_TOKEN!
NODE_EXTRA_CA_CERTS=/opt/zhudatuan/shared/tls/internal-ca.crt
KMS_ENDPOINT=https://127.0.0.1:8544
KMS_BEARER_TOKEN=REPLACE_WITH_THE_HBBTZN_IDENTITY_NOTIFICATION_KMS_BEARER_TOKEN!
IDENTITY_NOTIFICATION_CONFIG_REF=hbbtzn/nodes/l1/notification/aliyun-sms
JOB_WORKER_ID=hbbtzn-l1-identity-notification-1
NODE_MANIFEST_PATH=/opt/sfl/nodes/hbbtzn-l1/manifest.json
NODE_MANIFEST_ID=manifest:hbbtzn:l1:v1
NODE_MANIFEST_DIGEST=sha256:REPLACE_WITH_GENERATED_DIGEST
NODE_RUNTIME_INSTANCE_ID=runtime:hbbtzn:l1:commerce
NODE_RUNTIME_CONFIG_REF=sfl/nodes/hbbtzn-l1/runtime/v1
NODE_RESOURCE_BINDING_VERSION=1
NODE_RELEASE_POINTER_REF=/opt/sfl/nodes/hbbtzn-l1/current
