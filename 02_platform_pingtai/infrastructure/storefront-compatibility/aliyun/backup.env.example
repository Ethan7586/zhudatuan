# PostgreSQL connection used only by the backup job. Prefer a dedicated read-only backup role.
BACKUP_DATABASE_URL=postgresql://backup_user:password@db.example:5432/postgres?sslmode=require

# Use a private OSS bucket with versioning, server-side encryption and lifecycle rules.
BACKUP_OSS_REGION=oss-cn-beijing
BACKUP_OSS_BUCKET=smart-wing-private-backups
BACKUP_OSS_ACCESS_KEY_ID=
BACKUP_OSS_ACCESS_KEY_SECRET=
BACKUP_OSS_STS_TOKEN=

BACKUP_LOCAL_DIR=/var/backups/smart-wing/postgres
BACKUP_LOCAL_RETENTION_DAYS=7
