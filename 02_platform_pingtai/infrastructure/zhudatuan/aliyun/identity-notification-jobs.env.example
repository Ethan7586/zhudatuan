# Exact mutable allowlist for zhudatuan-identity-notification-jobs.service. The profile is pinned by systemd Environment.
APP_ENV=production
SERVICE_VERSION=replace-with-release-commit
DATABASE_JOB_CONNECTION_REF=zhudatuan/registration/database/jobs
SECRET_STORE_ENDPOINT=https://127.0.0.1:8543
SECRET_STORE_BEARER_TOKEN=REPLACE_WITH_THE_RUNTIME_SECRET_STORE_BEARER_TOKEN!
NODE_EXTRA_CA_CERTS=/opt/zhudatuan/shared/tls/internal-ca.crt
KMS_ENDPOINT=https://127.0.0.1:8544
KMS_BEARER_TOKEN=REPLACE_WITH_THE_RUNTIME_KMS_BEARER_TOKEN!
IDENTITY_NOTIFICATION_CONFIG_REF=zhudatuan/registration/notification/aliyun-sms
JOB_WORKER_ID=zhudatuan-identity-notification-1
