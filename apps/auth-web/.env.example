# Auth UI only. It must never contain database, service-role, or signing secrets.
# Console login and employee registration use the canonical identity API.
# Consumer password recovery remains on the compatibility BFF during the transition.
VITE_API_BASE_URL="https://api.zhudatuan.com"
VITE_CLIENT_VERSION="1.0.0"
VITE_AUTH_API_BASE_URL="/api"
VITE_STOREFRONT_ORIGIN="https://hbbtzn.com"
VITE_ADMIN_ORIGIN="https://console.zhudatuan.com"
# Vite dev-only proxy target. Auth routes are served by the storefront compatibility BFF.
AUTH_COMPAT_API_ORIGIN="http://127.0.0.1:3000"
