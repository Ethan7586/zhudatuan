    { "id": "database", "lane": "A3", "targets": ["core"], "include": ["02_platform_pingtai/database/**"], "touches": ["database"], "reason": "database migration or schema change" },
    { "id": "caddy", "lane": "A3", "targets": ["core"], "include": ["**/Caddyfile", "**/Caddyfile.*"], "touches": ["caddy"], "reason": "reverse proxy configuration" },
    { "id": "tunnel", "lane": "A3", "targets": ["core"], "include": ["**/*cloudflared*", "**/wrangler.json", "**/wrangler.jsonc", "02_platform_pingtai/infrastructure/**/cloudflare/**"], "touches": ["tunnel"], "reason": "edge or tunnel configuration" },
    { "id": "environment", "lane": "A3", "targets": ["core"], "include": ["**/*.env", "**/*.env.*", "**/*.env.example"], "touches": ["environment"], "reason": "runtime environment contract" },
    { "id": "sfl-node-kernel", "lane": "A2", "targets": ["console", "identity-api", "support-api", "purchase-api", "web-api", "catalog-api", "catalog-jobs", "payment-webhook-api", "payment-jobs"], "include": ["02_platform_pingtai/config/node-manifests/**", "02_platform_pingtai/config/sfl-*/**", "01_core_hexin/packages/config/src/SflNode*"], "touches": ["sfl-node-kernel"], "reason": "SFL node kernel or manifest affects console and commerce runtimes" },
    { "id": "catalog-media", "lane": "A0", "targets": ["catalog-media"], "include": ["01_core_hexin/apps/storefront-web/public/catalog-media/**"], "reason": "content-addressed catalog media" },
    { "id": "storefront", "lane": "A1", "targets": ["storefront"], "include": ["01_core_hexin/apps/storefront-web/**"], "exclude": ["01_core_hexin/apps/storefront-web/public/catalog-media/**"], "reason": "storefront-only change" },
    { "id": "auth-web", "lane": "A1", "targets": ["auth-web"], "include": ["01_core_hexin/apps/auth-web/**"], "reason": "auth static client change" },
    { "id": "console", "lane": "A1", "targets": ["console"], "include": ["01_core_hexin/apps/console/**"], "reason": "console static client change" },
    { "id": "session-resolver-compat", "lane": "A2", "targets": ["identity-api", "web-api"], "include": ["01_core_hexin/services/commerce/src/foundation/security/PgAccessResolvers*.ts"], "reason": "identity and web session database compatibility" },
    { "id": "mall-provisioning-isolation", "lane": "NONE", "targets": [], "include": ["01_core_hexin/services/commerce/src/modules/provisioning/03_application_yingyong/CreateMall.ts"], "reason": "mall provisioning dependency isolation is not hosted by a fast production target" },
    { "id": "identity-api-entry", "lane": "A2", "targets": ["identity-api"], "include": ["01_core_hexin/services/commerce/src/entry/IdentityRegistrationApi*", "01_core_hexin/services/commerce/src/bootstrap/IdentityRegistrationApiRuntime*"], "reason": "single identity runtime" },
    { "id": "support-api-entry", "lane": "A2", "targets": ["support-api"], "include": ["01_core_hexin/services/commerce/src/entry/ConsoleSupport*", "01_core_hexin/services/commerce/src/bootstrap/ConsoleSupportRuntime*"], "reason": "single support runtime" },
    { "id": "purchase-api-entry", "lane": "A2", "targets": ["purchase-api"], "include": ["01_core_hexin/services/commerce/src/entry/PurchaseApi*", "01_core_hexin/services/commerce/src/bootstrap/PurchaseApiRuntime*"], "reason": "single purchase runtime" },
    { "id": "web-api-entry", "lane": "A2", "targets": ["web-api"], "include": ["01_core_hexin/services/commerce/src/entry/WebBusinessApi*", "01_core_hexin/services/commerce/src/bootstrap/WebBusinessApiRuntime*"], "reason": "single web API runtime" },
    { "id": "catalog-api-entry", "lane": "A2", "targets": ["catalog-api"], "include": ["01_core_hexin/services/commerce/src/entry/CatalogOperatorApi*", "01_core_hexin/services/commerce/src/bootstrap/CatalogOperatorApiRuntime*"], "reason": "single catalog API runtime" },
    { "id": "catalog-jobs-entry", "lane": "A2", "targets": ["catalog-jobs"], "include": ["01_core_hexin/services/commerce/src/entry/CatalogJobs*", "01_core_hexin/services/commerce/src/bootstrap/CatalogJobsRuntime*"], "reason": "single catalog jobs runtime" },
    { "id": "payment-webhook-entry", "lane": "A2", "targets": ["payment-webhook-api"], "include": ["01_core_hexin/services/commerce/src/entry/PaymentWebhookApi*", "01_core_hexin/services/commerce/src/bootstrap/PaymentWebhookApiRuntime*"], "reason": "single payment webhook runtime" },
    { "id": "payment-jobs-entry", "lane": "A2", "targets": ["payment-jobs"], "include": ["01_core_hexin/services/commerce/src/entry/PaymentJobs*", "01_core_hexin/services/commerce/src/bootstrap/PaymentJobsRuntime*"], "reason": "single payment jobs runtime" },
    { "id": "commerce-shared", "lane": "A3", "targets": ["core"], "include": ["01_core_hexin/services/commerce/**"], "exclude": ["01_core_hexin/services/commerce/src/foundation/security/PgAccessResolvers*.ts", "01_core_hexin/services/commerce/src/modules/provisioning/03_application_yingyong/CreateMall.ts", "01_core_hexin/services/commerce/src/entry/IdentityRegistrationApi*", "01_core_hexin/services/commerce/src/bootstrap/IdentityRegistrationApiRuntime*", "01_core_hexin/services/commerce/src/entry/ConsoleSupport*", "01_core_hexin/services/commerce/src/bootstrap/ConsoleSupportRuntime*", "01_core_hexin/services/commerce/src/entry/PurchaseApi*", "01_core_hexin/services/commerce/src/bootstrap/PurchaseApiRuntime*", "01_core_hexin/services/commerce/src/entry/WebBusinessApi*", "01_core_hexin/services/commerce/src/bootstrap/WebBusinessApiRuntime*", "01_core_hexin/services/commerce/src/entry/CatalogOperatorApi*", "01_core_hexin/services/commerce/src/bootstrap/CatalogOperatorApiRuntime*", "01_core_hexin/services/commerce/src/entry/CatalogJobs*", "01_core_hexin/services/commerce/src/bootstrap/CatalogJobsRuntime*", "01_core_hexin/services/commerce/src/entry/PaymentWebhookApi*", "01_core_hexin/services/commerce/src/bootstrap/PaymentWebhookApiRuntime*", "01_core_hexin/services/commerce/src/entry/PaymentJobs*", "01_core_hexin/services/commerce/src/bootstrap/PaymentJobsRuntime*"], "dynamicImpact": "commerce-services", "reason": "shared commerce dependency" },
