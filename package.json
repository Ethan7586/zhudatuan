{
  "name": "zhudatuan-main",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "workspaces": [
    "apps/auth",
    "apps/console",
    "apps/storefront",
    "services/commerce",
    "packages/authz",
    "packages/config",
    "packages/contract",
    "packages/design",
    "packages/kernel",
    "packages/sdk",
    "packages/telemetry",
    "packages/testing",
    "extensions/channel/*",
    "extensions/notification/*",
    "extensions/payment/*",
    "tools/*"
  ],
  "scripts": {
    "local:prepare": "npm run prepare:local --workspace @shop/localinfra",
    "local:up": "docker compose --env-file infrastructure/container/local/.env.local -f infrastructure/container/local/compose.yml up -d --wait && node --import tsx tools/localinfra/src/Database.ts",
    "local:down": "docker compose --env-file infrastructure/container/local/.env.local -f infrastructure/container/local/compose.yml down",
    "local:services": "node --env-file=infrastructure/container/local/.env.local tools/localinfra/src/Launch.mjs --import tsx tools/localinfra/src/Run.ts",
    "local:verify-services": "node --env-file=infrastructure/container/local/.env.local tools/localinfra/src/Launch.mjs --import tsx tools/localinfra/src/Verify.ts",
    "local:migrate": "node --env-file=services/commerce/.env.local tools/localinfra/src/Launch.mjs --import tsx tools/seed/src/Migrate.ts",
    "local:seed": "node --env-file=services/commerce/.env.local tools/localinfra/src/Launch.mjs --import tsx tools/seed/src/Seed.ts",
    "local:verify": "node --env-file=services/commerce/.env.local tools/localinfra/src/Launch.mjs --import tsx tools/seed/src/Verify.ts",
    "dev:api": "npm run build:commerce && node --env-file=services/commerce/.env.local tools/localinfra/src/Launch.mjs services/commerce/dist/ApiMain.js",
    "dev:jobs": "npm run build:commerce && node --env-file=services/commerce/.env.local tools/localinfra/src/Launch.mjs services/commerce/dist/JobsMain.js",
    "dev:provider": "npm run build:commerce && node --env-file=services/commerce/.env.local tools/localinfra/src/Launch.mjs services/commerce/dist/ProviderMain.js",
    "dev:console": "npm run dev --workspace @shop/console",
    "dev:storefront": "npm run dev --workspace @shop/storefront",
    "dev:auth": "npm run dev --workspace @shop/auth",
    "build:console": "npm run build --workspace @shop/console",
    "build:storefront": "npm run build --workspace @shop/storefront",
    "build:auth": "npm run build --workspace @shop/auth",
    "build:clients:production": "node scripts/build-clients.mjs",
    "generate:design": "node scripts/build-web-tokens.mjs",
    "generate:runtime": "node scripts/build-runtime-config.mjs",
    "generate": "npm run generate --workspace @shop/contractgen && npm run generate --workspace @shop/navigationgen && npm run generate --workspace @shop/requirementgen && npm run generate --workspace @shop/providergen",
    "generate:clients": "npm run generate",
    "generate:frontendmanifest": "node scripts/evidence/frontendmanifest.mjs",
    "build:commerce": "node scripts/build-commerce.mjs",
    "build:workspace": "npm run build --workspaces --if-present",
    "build": "npm run build:workspace && npm run build:commerce",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tests/browser/tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run test:unit",
    "test:unit": "npm run test --workspaces --if-present",
    "test:contract": "npm run test:contract --workspace @shop/commerce && node --import tsx --test tests/contract/*.spec.ts",
    "test:integration": "npm run test:integration --workspace @shop/commerce && node --import tsx --test tests/integration/*.spec.ts tests/recovery/*.spec.ts",
    "test:adapters": "node scripts/check/adapters.mjs",
    "test:component": "npm run test:component --workspaces --if-present",
    "test:e2e": "playwright test",
    "test:journey": "node --import tsx --test tests/journey/*.spec.ts",
    "test:security": "node --import tsx --test tests/security/*.spec.ts",
    "test:performance": "node --import tsx --test tests/performance/*.spec.ts",
    "smoke:mallentry": "node --import tsx scripts/smoke/MallEntry.ts",
    "test:sql": "node scripts/audit/database-contracts.mjs --environment-bootstrap",
    "test:mvp": "node --import tsx scripts/audit/database-contracts.mjs --mvp-kernel",
    "format": "prettier --write --ignore-unknown .",
    "check:format": "prettier --check --ignore-unknown .",
    "check:cleaninstall": "node scripts/check/lock.mjs",
    "check:artifacts": "node scripts/check/artifacts.mjs",
    "check:generated": "node scripts/audit/generated.mjs",
    "check:errors": "node scripts/check/errors.mjs",
    "check:requirements": "npm run check --workspace @shop/requirementgen",
    "check:naming": "node scripts/audit/naming.mjs",
    "check:boundaries": "node scripts/audit/boundary.mjs",
    "check:ownership": "node scripts/check/ownership.mjs",
    "check:duplicates": "node scripts/check/duplicates.mjs",
    "check:calls": "node scripts/check/calls.mjs",
    "check:pagination": "node scripts/check/pagination.mjs",
    "check:performance": "node scripts/check/performance.mjs",
    "check:transactions": "node scripts/check/transactions.mjs",
    "check:frontend": "node scripts/check/frontend.mjs",
    "check:visuals": "node scripts/check/visuals.mjs",
    "check:frontendmanifest": "node scripts/evidence/frontendmanifest.mjs --check",
    "check:tests": "node scripts/check/tests.mjs",
    "check:lines": "node scripts/check-line-budget.mjs",
    "check:deployment": "node scripts/check/deployment.mjs",
    "check:supplychain": "node scripts/check/supplychain.mjs",
    "check:bundles": "node scripts/audit/bundles.mjs",
    "check:extensions": "node scripts/audit/extensions.mjs",
    "check:jobs": "node scripts/audit/jobs.mjs",
    "check:navigation": "npm run check --workspace @shop/navigationgen && node scripts/audit/navigation.mjs",
    "check:dependencies": "node scripts/audit/dependencies.mjs",
    "check:database": "node scripts/audit/database.mjs",
    "check:migrations": "node scripts/audit/migrations.mjs",
    "check:operations": "node scripts/audit/operations.mjs",
    "check:events": "node scripts/audit/events.mjs",
    "check:providers": "npm run check --workspace @shop/providergen && node scripts/audit/providers.mjs",
    "check:requirementgraph": "node --import tsx scripts/audit/requirements.mjs",
    "check:runtimegraph": "node scripts/audit/runtimegraph.mjs",
    "check:environment": "node scripts/audit/environment.mjs",
    "check:delivery": "node scripts/check-platform-delivery.mjs",
    "check:release": "node scripts/audit/release.mjs",
    "check:p0": "node scripts/verify-p0.mjs",
    "check:regression": "node scripts/audit/regression.mjs",
    "audit:architecture": "npm run check:naming && npm run check:boundaries && npm run check:ownership && npm run check:duplicates && npm run check:calls && npm run check:pagination && npm run check:performance && npm run check:transactions && npm run check:frontend && npm run check:visuals && npm run check:frontendmanifest && npm run check:tests && npm run check:operations && npm run check:events && npm run check:providers && npm run check:extensions && npm run check:jobs && npm run check:navigation && npm run check:dependencies && npm run check:requirementgraph && npm run check:runtimegraph && npm run check:environment && npm run check:delivery && npm run check:p0 && npm run check:regression",
    "check:migration-inventory": "node scripts/audit/database-contracts.mjs --check-inventory",
    "database:replay": "node scripts/audit/database-contracts.mjs --schema-fresh",
    "replay:postgres": "node scripts/audit/database-contracts.mjs --postgres-fresh",
    "test:inventory-cutover-unsafe": "node scripts/audit/database-contracts.mjs --inventory-cutover-unsafe",
    "test:environment-bootstrap": "node scripts/audit/database-contracts.mjs --environment-bootstrap",
    "replay:fresh": "npm run database:replay && npm run test:inventory-cutover-unsafe && npm run test:environment-bootstrap",
    "quality": "npm run check:cleaninstall && npm run check:supplychain && npm run check:generated && npm run check:errors && npm run check:requirements && npm run audit:architecture && npm run check:lines && npm run check:deployment && npm run typecheck && npm run check:migrations && npm run test:sql && npm run test:mvp && npm run test:unit && npm run test:contract && npm run test:integration && npm run test:adapters && npm run test:component && npm run test:e2e && npm run test:journey && npm run test:security && npm run test:performance && npm run build && npm run check:bundles && npm run audit:prod",
    "audit:prod": "npm audit --omit=dev"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.4.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "eslint": "10.9.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "esbuild": "0.28.1",
    "globals": "17.11.0",
    "jsqr": "1.4.0",
    "prettier": "3.5.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "yaml": "2.9.0"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "0.28.1",
    "@rolldown/binding-linux-x64-gnu": "1.1.5",
    "@rolldown/binding-linux-x64-musl": "1.1.5",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
    "@tailwindcss/oxide-linux-x64-musl": "4.3.3",
    "lightningcss-linux-x64-gnu": "1.32.0",
    "lightningcss-linux-x64-musl": "1.32.0"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "fast-uri": "3.1.5",
    "nanoid": "3.3.18",
    "sharp": "0.35.3"
  }
}
