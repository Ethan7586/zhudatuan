[Unit]
Description=Zhudatuan one-shot canonical Console Owner bootstrap
Requires=zhudatuan-registration-database.service zhudatuan-internal-runtime.service zhudatuan-migration.service
After=network-online.target zhudatuan-registration-database.service zhudatuan-internal-runtime.service zhudatuan-migration.service
ConditionPathExists=/opt/zhudatuan/current/services/commerce/dist/BootstrapOwner.js
ConditionPathExists=/opt/zhudatuan/shared/owner-bootstrap.env

[Service]
Type=oneshot
User=zhudatuan
Group=zhudatuan
WorkingDirectory=/opt/zhudatuan/current
Environment=NODE_ENV=production
EnvironmentFile=/opt/zhudatuan/shared/owner-bootstrap.env
ExecStart=/usr/bin/node services/commerce/dist/BootstrapOwner.js
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
PrivateDevices=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/opt/zhudatuan/current /opt/zhudatuan/shared
InaccessiblePaths=-/opt/smart-wing -/opt/smart-wiston -/opt/shop-test
