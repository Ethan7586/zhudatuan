# Ephemeral root-only input for zhudatuan-staging-full-rds-init.service.
# Install as /run/zhudatuan-staging-full/rds-init.env with root:root 0600,
# start the one-shot once, then delete the file before any public runtime starts.
POSTGRES_USER=replace-with-isolated-staging-rds-admin-user
PGPASSWORD=replace-with-isolated-staging-rds-admin-password
ZHUDATUAN_EXPECTED_RDS_SERVER_ADDR=replace-with-exact-private-rds-ip
SHOPAPP_PASSWORD=replace-with-random-unused-legacy-api-password
SHOPJOB_PASSWORD=replace-with-random-unused-legacy-job-password
SHOPMIGRATION_PASSWORD=replace-with-random-migration-password
SHOPREAD_PASSWORD=replace-with-random-unused-read-password
ZHUDATUAN_IDENTITY_API_PASSWORD=replace-with-random-registration-api-password
ZHUDATUAN_IDENTITY_JOB_PASSWORD=replace-with-random-identity-job-password
ZHUDATUAN_BOOTSTRAP_PASSWORD=replace-with-random-bootstrap-password
ZHUDATUAN_WEB_API_PASSWORD=replace-with-random-web-business-api-password
ZHUDATUAN_PURCHASE_API_PASSWORD=replace-with-random-purchase-only-api-password
ZHUDATUAN_SANDBOX_BOOTSTRAP_PASSWORD=replace-with-random-one-shot-sandbox-bootstrap-password
ZHUDATUAN_DATABASE_SENTINEL=replace-with-at-least-43-url-safe-random-characters
