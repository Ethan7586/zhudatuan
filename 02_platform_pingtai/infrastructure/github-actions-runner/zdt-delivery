#!/usr/bin/env bash
# Control-side Runner 1.6 entry. It only loads the latest control plane and dispatches GitHub Actions.
set -euo pipefail

operation="${1:-}"
case "$operation" in
  release|status|retry)
    [ "$#" -eq 2 ] || { echo "Usage: zdt-delivery $operation <full-source-sha-or-release-id>" >&2; exit 64; }
    ;;
  rollback)
    [ "$#" -eq 3 ] || { echo 'Usage: zdt-delivery rollback <target> <physical-node>' >&2; exit 64; }
    ;;
  *)
    echo 'Usage: zdt-delivery release <full-source-sha>' >&2
    echo '       zdt-delivery status <full-source-sha-or-release-id>' >&2
    echo '       zdt-delivery retry <release-id>' >&2
    echo '       zdt-delivery rollback <target> <physical-node>' >&2
    exit 64
    ;;
esac

repository_root="${ZDT_GIT_ANCHOR:-/Users/Ethan/Desktop/zdt-next}"
git -C "$repository_root" rev-parse --git-dir >/dev/null 2>&1 || { echo "Git anchor unavailable: $repository_root" >&2; exit 1; }
control_parent="$(mktemp -d /private/tmp/zdt-delivery-control.XXXXXX)"
control_root="$control_parent/zdt-next"
added=false
cleanup() {
  if [ "$added" = true ]; then git -C "$repository_root" worktree remove --force "$control_root" >/dev/null 2>&1 || true; fi
  rmdir "$control_parent" >/dev/null 2>&1 || true
}
trap cleanup EXIT
git -C "$repository_root" fetch origin zdt-next --quiet
control_sha="$(git -C "$repository_root" rev-parse origin/zdt-next)"
git -C "$repository_root" worktree add --detach "$control_root" "$control_sha" --quiet
added=true
printf 'Delivery control: %s\n' "$control_sha"
exec bash "$control_root/scripts/delivery-dispatch.sh" "$@"
