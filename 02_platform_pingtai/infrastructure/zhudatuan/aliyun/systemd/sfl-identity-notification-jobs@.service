[Unit]
Description=SFL node-scoped identity notification worker (%i)
Requires=zhudatuan-internal-runtime.service
After=network-online.target zhudatuan-migration.service zhudatuan-internal-runtime.service
ConditionPathExists=/opt/sfl/nodes/%i/current/01_core_hexin/services/commerce/dist/IdentityNotificationJobsOnlyMain.js
ConditionPathExists=/opt/sfl/nodes/%i/current/01_core_hexin/services/commerce/dist/IdentityNotificationJobsReadyMain.js
ConditionPathExists=/opt/sfl/nodes/%i/runtime/identity-notification-jobs.env

[Service]
Type=simple
User=zhudatuan
Group=zhudatuan
WorkingDirectory=/opt/sfl/nodes/%i/current
Environment=NODE_ENV=production
Environment=JOB_RUNTIME_PROFILE=identity-notification-only
EnvironmentFile=/opt/sfl/nodes/%i/runtime/identity-notification-jobs.env
ExecStartPre=/usr/bin/node 01_core_hexin/services/commerce/dist/IdentityNotificationJobsReadyMain.js
ExecStart=/usr/bin/node 01_core_hexin/services/commerce/dist/IdentityNotificationJobsOnlyMain.js
Restart=on-failure
RestartSec=3
TimeoutStartSec=30
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
PrivateDevices=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/opt/sfl/nodes/%i /opt/zhudatuan/shared

[Install]
WantedBy=multi-user.target
