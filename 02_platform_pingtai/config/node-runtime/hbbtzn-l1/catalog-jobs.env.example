APP_ENV=production
SERVICE_VERSION=replace-with-release-source-sha
DATABASE_JOB_CONNECTION_REF=hbbtzn/nodes/l1/database/catalog-jobs
DATABASE_JOB_ROLE=shopjob
JOB_WORKER_ID=hbbtzn-l1-catalog-1
OBJECT_STORE_ENDPOINT=https://127.0.0.1:8655
OBJECT_STORE_BEARER_TOKEN=REPLACE_WITH_L1_OBJECT_STORE_TOKEN
SECRET_STORE_ENDPOINT=https://127.0.0.1:8543
SECRET_STORE_BEARER_TOKEN=REPLACE_WITH_CATALOG_JOBS_SECRET_STORE_TOKEN
NODE_MANIFEST_PATH=/opt/sfl/nodes/hbbtzn-l1/manifest.json
NODE_MANIFEST_ID=manifest:hbbtzn:l1:v1
NODE_MANIFEST_DIGEST=sha256:REPLACE_WITH_GENERATED_DIGEST
NODE_RUNTIME_INSTANCE_ID=runtime:hbbtzn:l1:commerce
NODE_RUNTIME_CONFIG_REF=sfl/nodes/hbbtzn-l1/runtime/v1
NODE_RESOURCE_BINDING_VERSION=1
NODE_RELEASE_POINTER_REF=/opt/sfl/nodes/hbbtzn-l1/current
NODE_EXTRA_CA_CERTS=/opt/zhudatuan/shared/tls/internal-ca.crt
CATALOG_MEDIA_REPLICATION_ENABLED=false
CATALOG_MEDIA_PRIMARY_TARGET_ID=zhudatuan
CATALOG_MEDIA_ZHUDATUAN_PROVIDER=aliyun-oss
CATALOG_MEDIA_ZHUDATUAN_ENDPOINT=REPLACE_WITH_OSS_ENDPOINT
CATALOG_MEDIA_ZHUDATUAN_REGION=REPLACE_WITH_OSS_REGION
CATALOG_MEDIA_ZHUDATUAN_BUCKET=REPLACE_WITH_OSS_BUCKET
CATALOG_MEDIA_ZHUDATUAN_PUBLIC_BASE_URL=https://media.zhudatuan.com
CATALOG_MEDIA_ZHUDATUAN_REQUIRED=true
CATALOG_MEDIA_ZHUDATUAN_ENABLED=true
CATALOG_MEDIA_ZHUDATUAN_ACCESS_KEY_ID=REPLACE_WITH_OSS_ACCESS_KEY_ID
CATALOG_MEDIA_ZHUDATUAN_ACCESS_KEY_SECRET=REPLACE_WITH_OSS_ACCESS_KEY_SECRET
CATALOG_MEDIA_FUFU_PROVIDER=aliyun-oss
CATALOG_MEDIA_FUFU_ENDPOINT=REPLACE_WITH_OSS_ENDPOINT
CATALOG_MEDIA_FUFU_REGION=REPLACE_WITH_OSS_REGION
CATALOG_MEDIA_FUFU_BUCKET=REPLACE_WITH_OSS_BUCKET
CATALOG_MEDIA_FUFU_PUBLIC_BASE_URL=https://media.fufu.com
CATALOG_MEDIA_FUFU_REQUIRED=true
CATALOG_MEDIA_FUFU_ENABLED=true
CATALOG_MEDIA_FUFU_ACCESS_KEY_ID=REPLACE_WITH_OSS_ACCESS_KEY_ID
CATALOG_MEDIA_FUFU_ACCESS_KEY_SECRET=REPLACE_WITH_OSS_ACCESS_KEY_SECRET
