APP_ENV=production
AUTH_MODE=membership
SERVICE_VERSION=replace-with-release-source-sha
API_PORT=4432
API_ALLOWED_ORIGINS=https://console.fufuwang.com.cn,https://h5.fufuwang.com.cn,https://h6.fufuwang.com.cn,https://fufuwang.com.cn,https://mall.fufuwang.com.cn,https://www.fufuwang.com.cn
PUBLIC_MALL_SLUG=zdt-l1-verify
PUBLIC_MALL_HOST_MAPPINGS=fufuwang.com.cn=zdt-l1-verify,h5.fufuwang.com.cn=zdt-l1-verify,h6.fufuwang.com.cn=h6,mall.fufuwang.com.cn=zdt-l1-verify,www.fufuwang.com.cn=zdt-l1-verify
DATABASE_API_CONNECTION_REF=hbbtzn/nodes/l1/database/web-api
DATABASE_API_ROLE=zhudatuanwebapi
KMS_ENDPOINT=https://127.0.0.1:8544
KMS_BEARER_TOKEN=REPLACE_WITH_WEB_API_KMS_TOKEN
SECRET_STORE_ENDPOINT=https://127.0.0.1:8543
SECRET_STORE_BEARER_TOKEN=REPLACE_WITH_WEB_API_SECRET_STORE_TOKEN
NODE_MANIFEST_PATH=/opt/sfl/nodes/hbbtzn-l1/manifest.json
NODE_MANIFEST_ID=manifest:hbbtzn:l1:v1
NODE_MANIFEST_DIGEST=sha256:REPLACE_WITH_GENERATED_DIGEST
NODE_RUNTIME_INSTANCE_ID=runtime:hbbtzn:l1:commerce
NODE_RUNTIME_CONFIG_REF=sfl/nodes/hbbtzn-l1/runtime/v1
NODE_RESOURCE_BINDING_VERSION=1
NODE_RELEASE_POINTER_REF=/opt/sfl/nodes/hbbtzn-l1/current
NODE_EXTRA_CA_CERTS=/opt/zhudatuan/shared/tls/internal-ca.crt
