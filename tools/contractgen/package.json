{
  "name": "@shop/contractgen",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "npm run typecheck",
    "generate": "node --import tsx src/ContractGenerator.ts",
    "generate:client": "node --import tsx src/ContractGenerator.ts --scope=contract-sdk",
    "check": "node --import tsx src/ContractGenerator.ts --check",
    "check:client": "node --import tsx src/ContractGenerator.ts --scope=contract-sdk --check",
    "lint": "npm run typecheck",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@shop/authz": "1.0.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
