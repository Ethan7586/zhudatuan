# Client-visible account-center origin. The resolver accepts only the canonical
# production origin or the approved local :3002 development origin.
NEXT_PUBLIC_AUTH_ORIGIN="http://127.0.0.1:3002"

# Runtime-only boundary. Production must set APP_ENV=production so preview
# routes are served only by labs.zhudatuan.com, never by zhudatuan.com.
APP_ENV="development"
