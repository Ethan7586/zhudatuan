[Unit]
Description=Zhudatuan isolated catalog API
Requires=zhudatuan-internal-runtime.service zhudatuan-object-store.service
After=network-online.target zhudatuan-migration.service zhudatuan-internal-runtime.service zhudatuan-object-store.service
ConditionPathExists=/opt/zhudatuan/targets/catalog-api/current/service/CatalogOperatorApiMain.js
ConditionPathExists=/opt/zhudatuan/targets/catalog-api/current/service/CatalogOperatorApiReadyMain.js
ConditionPathExists=/opt/zhudatuan/shared/catalog-api.env

[Service]
Type=simple
User=zhudatuan
Group=zhudatuan
WorkingDirectory=/opt/zhudatuan/targets/catalog-api/current
Environment=NODE_ENV=production
Environment=CATALOG_OPERATOR_API_PROFILE=catalog-operator-only
Environment=API_PORT=4324
Environment=API_BIND_HOST=127.0.0.1
EnvironmentFile=/opt/zhudatuan/shared/catalog-api.env
ExecStart=/usr/bin/node service/CatalogOperatorApiMain.js
ExecStartPost=/usr/bin/node service/CatalogOperatorApiReadyMain.js
Restart=on-failure
RestartSec=3
TimeoutStartSec=30
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
PrivateDevices=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/opt/zhudatuan/targets/catalog-api /opt/zhudatuan/shared
InaccessiblePaths=-/opt/smart-wing -/opt/smart-wiston -/opt/shop-test

[Install]
WantedBy=multi-user.target
