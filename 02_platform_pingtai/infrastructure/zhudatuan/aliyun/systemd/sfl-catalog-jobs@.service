[Unit]
Description=SFL node-bound catalog jobs (%i)
Requires=zhudatuan-internal-runtime.service sfl-catalog-object-store@%i.service
After=network-online.target zhudatuan-migration.service zhudatuan-internal-runtime.service sfl-catalog-object-store@%i.service
ConditionPathExists=/opt/sfl/nodes/%i/targets/catalog-jobs/current/service/CatalogJobsMain.js
ConditionPathExists=/opt/sfl/nodes/%i/targets/catalog-jobs/current/service/CatalogJobsReadyMain.js
ConditionPathExists=/opt/sfl/nodes/%i/runtime/catalog-jobs.env

[Service]
Type=simple
User=zhudatuan
Group=zhudatuan
WorkingDirectory=/opt/sfl/nodes/%i/targets/catalog-jobs/current
Environment=NODE_ENV=production
EnvironmentFile=/opt/sfl/nodes/%i/runtime/catalog-jobs.env
ExecStartPre=/usr/bin/node service/CatalogJobsReadyMain.js
ExecStart=/usr/bin/node service/CatalogJobsMain.js
Restart=on-failure
RestartSec=3
TimeoutStartSec=30
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
PrivateDevices=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/opt/sfl/nodes/%i /opt/zhudatuan/shared

[Install]
WantedBy=multi-user.target
