[Unit]
Description=Zhudatuan full staging identity registration API
Wants=network-online.target
Requires=zhudatuan-staging-full-postgres-proxy.service zhudatuan-staging-full-internal-runtime.service
After=network-online.target zhudatuan-staging-full-postgres-proxy.service zhudatuan-staging-full-internal-runtime.service zhudatuan-staging-full-migration.service zhudatuan-staging-full-owner-bootstrap.service zhudatuan-staging-full-database-retire.service
ConditionPathExists=/opt/zhudatuan-staging-full/current/services/commerce/dist/IdentityRegistrationApiMain.js
ConditionPathExists=/opt/zhudatuan-staging-full/current/services/commerce/dist/IdentityRegistrationApiReadyMain.js
ConditionPathExists=/opt/zhudatuan-staging-full/shared/full-identity-registration-api.env
ConditionPathExists=/opt/zhudatuan-staging-full/shared/tls/internal-ca.crt
ConditionPathExists=!/opt/zhudatuan-staging-full/shared/full-migration.env
ConditionPathExists=!/opt/zhudatuan-staging-full/shared/full-owner-bootstrap.env
ConditionPathExists=!/run/zhudatuan-staging-full/rds-init.env
ConditionPathExists=!/run/zhudatuan-staging-full/database-retire.env
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
DynamicUser=yes
User=zdt-stg-full-api
WorkingDirectory=/opt/zhudatuan-staging-full/current
EnvironmentFile=/opt/zhudatuan-staging-full/shared/full-identity-registration-api.env
LoadCredential=internal-ca.crt:/opt/zhudatuan-staging-full/shared/tls/internal-ca.crt
ExecStart=/usr/bin/env NODE_ENV=production APP_ENV=test AUTH_MODE=membership \
  IDENTITY_REGISTRATION_API_PROFILE=registration-only API_BIND_HOST=127.0.0.1 API_PORT=4431 \
  DATABASE_API_CONNECTION_REF=zhudatuan/staging/full/database/identity-api \
  SESSION_KEY_REF=zhudatuan/staging/full/identity/session IDENTITY_KEY_REF=zhudatuan/staging/full/identity/index \
  SECRET_STORE_ENDPOINT=https://127.0.0.1:8643 KMS_ENDPOINT=https://127.0.0.1:8644 \
  NODE_EXTRA_CA_CERTS=%d/internal-ca.crt \
  /usr/bin/node services/commerce/dist/IdentityRegistrationApiMain.js
ExecStartPost=/usr/bin/env NODE_ENV=production APP_ENV=test AUTH_MODE=membership \
  IDENTITY_REGISTRATION_API_PROFILE=registration-only API_BIND_HOST=127.0.0.1 API_PORT=4431 \
  DATABASE_API_CONNECTION_REF=zhudatuan/staging/full/database/identity-api \
  SESSION_KEY_REF=zhudatuan/staging/full/identity/session IDENTITY_KEY_REF=zhudatuan/staging/full/identity/index \
  SECRET_STORE_ENDPOINT=https://127.0.0.1:8643 KMS_ENDPOINT=https://127.0.0.1:8644 \
  NODE_EXTRA_CA_CERTS=%d/internal-ca.crt \
  /usr/bin/node services/commerce/dist/IdentityRegistrationApiReadyMain.js
Restart=on-failure
RestartSec=3
TimeoutStartSec=45
TimeoutStopSec=45
RuntimeDirectory=zdt-stg-full-api
RuntimeDirectoryMode=0700
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zhudatuan-staging-full-identity-api
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
KeyringMode=private
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SocketBindDeny=any
SocketBindAllow=ipv4:tcp:4431
IPAddressDeny=any
IPAddressAllow=localhost
ReadOnlyPaths=/opt/zhudatuan-staging-full/current /opt/zhudatuan-staging-full/shared
InaccessiblePaths=-/opt/zhudatuan -/opt/smart-wing -/opt/smart-wiston -/opt/shop-test

# Deliberately no [Install]: P10 starts this unit explicitly after evidence verification.
