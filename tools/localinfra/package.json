{
  "name": "@shop/localinfra",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "dependencies": {
    "@shop/config": "1.0.0"
  },
  "scripts": {
    "build": "npm run typecheck",
    "lint": "npm run typecheck",
    "prepare:local": "node --import tsx src/Prepare.ts",
    "start": "node --import tsx src/Run.ts",
    "verify": "node --import tsx src/Verify.ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
