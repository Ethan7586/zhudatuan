APP_ENV=test
ZHUDATUAN_REGISTRATION_BOOTSTRAP_CONFIRM=INDEPENDENT_TEST_DB_ONLY
ZHUDATUAN_REGISTRATION_BOOTSTRAP_DATABASE_URL=postgresql://zhudatuanbootstrap:replace-password@127.0.0.1:55432/zhudatuan_registration
ZHUDATUAN_REGISTRATION_BOOTSTRAP_DATABASE_NAME=zhudatuan_registration
ZHUDATUAN_REGISTRATION_BOOTSTRAP_OUTPUT=/opt/zhudatuan/shared/registration-bootstrap/registration-invitation.json
ZHUDATUAN_REGISTRATION_BOOTSTRAP_ACTOR=owner:Ethan
ZHUDATUAN_REGISTRATION_BOOTSTRAP_EXPIRES_HOURS=24
ZHUDATUAN_REGISTRATION_BOOTSTRAP_SENTINEL=copy-the-exact-random-value-from-postgres-env
SECRET_STORE_ENDPOINT=https://127.0.0.1:8543
SECRET_STORE_BEARER_TOKEN=REPLACE_WITH_THE_RUNTIME_SECRET_STORE_BEARER_TOKEN!
IDENTITY_KEY_REF=zhudatuan/registration/identity/index
NODE_EXTRA_CA_CERTS=/opt/zhudatuan/shared/tls/internal-ca.crt
