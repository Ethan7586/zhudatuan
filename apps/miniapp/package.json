{
  "name": "@shop/miniapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/build-miniapp-theme.mjs && node --import tsx scripts/Build.ts --watch",
    "build": "node ../../scripts/build-miniapp-theme.mjs && node --import tsx scripts/Build.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:component": "vitest run --config vitest.config.ts test/Page.test.ts",
    "test:device": "npm run build && node --import tsx scripts/DeviceGate.ts",
    "device:hash": "npm run build && node --import tsx scripts/DeviceGate.ts --hash",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck"
  },
  "dependencies": {
    "@shop/config": "1.0.0",
    "@shop/contract": "1.0.0",
    "@shop/presentation": "1.0.0",
    "@shop/sdk": "1.0.0",
    "esbuild": "0.28.1",
    "qrcode-generator": "1.4.4"
  },
  "devDependencies": {
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
