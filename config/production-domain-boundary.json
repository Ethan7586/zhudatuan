{
  "schema": "zhudatuan.production-domain-boundary.v1",
  "decision": "2026-09-03-owner-approved-zhudatuan-domain-family",
  "frontends": {
    "h5": {
      "publicOrigin": "https://h5.zhudatuan.com",
      "apiOrigin": "https://api.zhudatuan.com",
      "authOrigin": "https://accounts.zhudatuan.com"
    },
    "miniProgram": {
      "publicDomain": "h5.zhudatuan.com",
      "apiOrigin": "https://api.zhudatuan.com",
      "authOrigin": "https://accounts.zhudatuan.com"
    }
  },
  "controlPlane": {
    "accountsOrigin": "https://accounts.zhudatuan.com",
    "consoleOrigin": "https://console.zhudatuan.com",
    "apiOrigin": "https://api.zhudatuan.com"
  },
  "canonicalOrigins": {
    "storefrontOrigin": "https://zhudatuan.com"
  },
  "redirectOnlyAliases": {
    "https://accounts.hbbtzn.com": "https://accounts.zhudatuan.com",
    "https://api.hbbtzn.com": "https://api.zhudatuan.com",
    "https://mall.hbbtzn.com": "https://hbbtzn.com"
  },
  "identityApi": {
    "allowedOrigins": [
      "https://accounts.zhudatuan.com",
      "https://console.zhudatuan.com",
      "https://h5.zhudatuan.com",
      "https://zhudatuan.com"
    ],
    "returnTargets": {
      "console": "https://console.zhudatuan.com",
      "storefront": "https://zhudatuan.com",
      "store": "https://console.zhudatuan.com/entrances/store",
      "supplier": "https://console.zhudatuan.com/entrances/supplier"
    }
  },
  "edge": {
    "h5": {
      "workerName": "zhudatuan-h5",
      "publicOrigin": "https://h5.zhudatuan.com",
      "canonicalWebOrigin": "https://zhudatuan.com",
      "deploymentArtifact": "apps/storefront-web/dist/server/index.js",
      "documentRoute": "/h5"
    },
    "legacyHbbtzn": {
      "workerName": "zhudatuan-hbbtzn-alias",
      "publicOrigin": "https://hbbtzn.com",
      "preserveOnly": true
    }
  },
  "changePolicy": {
    "ownerApprovalRequired": true,
    "frontendDomainChangeDoesNotAuthorizeControlPlaneChange": true,
    "globalDomainReplacementForbidden": true
  }
}
