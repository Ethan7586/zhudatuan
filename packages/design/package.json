{
  "name": "@shop/design",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "npm run typecheck",
    "lint": "npm run typecheck",
    "storybook": "storybook dev --config-dir .storybook --port 6006",
    "storybook:build": "storybook build --config-dir .storybook",
    "test": "vitest run --exclude src/organism/ResourceState.component.test.tsx --exclude src/organism/Dialog.component.test.tsx --exclude src/molecule/RouteLoading.component.test.tsx --passWithNoTests",
    "test:component": "vitest run src/organism/ResourceState.component.test.tsx src/organism/Dialog.component.test.tsx src/molecule/RouteLoading.component.test.tsx",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": "./src/index.ts",
    "./atom/Brand": "./src/atom/Brand.tsx",
    "./atom/QrCode": "./src/atom/QrCode.tsx",
    "./token/Base.css": "./src/token/Base.css",
    "./token/Tailwind.css": "./src/token/Tailwind.css",
    "./token/Tokens.css": "./src/token/Tokens.css",
    "./organism/CommandDialog.css": "./src/organism/CommandDialog.css",
    "./template/Workspace.css": "./src/template/Workspace.css",
    "./template/WorkspaceShell.css": "./src/template/WorkspaceShell.css",
    "./tokens.json": "./src/tokens.json",
    "./mobile-platforms.json": "./src/mobile-platforms.json",
    "./template/OperatorWorkspace.css": "./src/template/OperatorWorkspace.css",
    "./brand/*": "./src/brand/*"
  },
  "types": "./src/index.ts",
  "dependencies": {
    "@shop/presentation": "1.0.0",
    "@tanstack/react-table": "9.1.2",
    "qrcode-generator": "1.4.4",
    "react": "19.2.8",
    "react-aria-components": "1.20.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/react-vite": "10.5.10",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/react": "19.2.14",
    "jsdom": "30.0.1",
    "storybook": "10.5.10",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "optionalDependencies": {
    "@oxc-parser/binding-linux-x64-gnu": "0.127.0",
    "@oxc-parser/binding-linux-x64-musl": "0.127.0",
    "@oxc-resolver/binding-linux-x64-gnu": "11.21.2",
    "@oxc-resolver/binding-linux-x64-musl": "11.21.2"
  }
}
