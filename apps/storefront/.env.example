# Client-visible account-center origin. The resolver accepts only the canonical
# production origin or the approved local :3002 development origin.
VITE_AUTH_BASE_URL="http://127.0.0.1:3002"

# Canonical Contract v2 API. Production only accepts https://api.zhudatuan.com;
# local development accepts the commerce runtime on port 3001.
VITE_API_BASE_URL="http://127.0.0.1:3001"

# Immutable client release identity sent with every canonical request.
VITE_CLIENT_VERSION="0.0.0"
