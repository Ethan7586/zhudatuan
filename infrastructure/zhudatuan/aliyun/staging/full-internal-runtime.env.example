# Dedicated full-staging Secret Store and KMS. systemd pins APP_ENV=production
# and LOCAL_RUNTIME_PROFILE=registration-only, which bundles only Secret Store/KMS.
LOCAL_TLS_KEY_FILE=/opt/zhudatuan-staging-full/shared/tls/internal.key
LOCAL_TLS_CERT_FILE=/opt/zhudatuan-staging-full/shared/tls/internal.crt
LOCAL_SECRETS_FILE=/opt/zhudatuan-staging-full/shared/full-secrets.json
LOCAL_SECRETS_PORT=8643
LOCAL_KMS_PORT=8644
LOCAL_KMS_MASTER_KEY=REPLACE_WITH_EXACT_32_BYTE_BASE64URL_STAGING_MASTER_KEY
LOCAL_SECRET_STORE_BEARER_TOKEN=REPLACE_FULL_SHARED_SECRET_STORE_TOKEN_000000000000
LOCAL_KMS_BEARER_TOKEN=REPLACE_FULL_SHARED_KMS_TOKEN_000000000000000000
NODE_EXTRA_CA_CERTS=/opt/zhudatuan-staging-full/shared/tls/internal-ca.crt
